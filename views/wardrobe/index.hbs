<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <header class="mb-5 flex flex-col gap-4 border-b border-slate-800 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-9 text-emerald-400"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.125 15.367 10.128 11.99A3.78 3.78 0 0 1 12 11.5c.675 0 1.277.156 1.872.49l6.003 3.377A2.208 2.208 0 0 1 18.792 19.5H5.208a2.208 2.208 0 0 1-1.083-4.133Z"
        />
        <path
          stroke-linecap="round"
          d="M10 6.405A1.953 1.953 0 0 1 12 4.5c1.105 0 2 .853 2 1.905 0 .72-.419 1.346-1.038 1.67C12.473 8.331 12 8.757 12 9.31V11.5"
        />
      </svg>
      <div>
        <div class="text-2xl font-bold tracking-normal">
          Libre <span class="text-emerald-400">Closet</span>
        </div>
        <div class="text-sm text-slate-400">My wardrobe</div>
      </div>
    </div>

    <form method="get" action="/wardrobe" class="flex w-full max-w-2xl items-center gap-2 rounded-lg border border-slate-800 bg-slate-900 px-4 py-2 shadow-lg shadow-black/20">
      {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
      <input type="hidden" name="category" value="{{search.category}}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-slate-400">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
      </svg>
      <input
        type="text"
        name="keyword"
        value="{{search.keyword}}"
        placeholder="Search your wardrobe..."
        class="min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-slate-500"
      />
      <button type="submit" class="btn btn-ghost btn-sm border border-slate-700">Search</button>
    </form>

    <div class="flex items-center gap-2">
      <a href="/wardrobe/settings" class="btn btn-ghost btn-square border border-slate-800 bg-slate-900 text-slate-200" title="Settings">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.592c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.661.837.145.063.287.13.427.203.33.17.724.15 1.032-.064l1.055-.732a1.125 1.125 0 0 1 1.45.12l1.833 1.833c.389.389.44 1.002.12 1.45l-.732 1.055c-.214.308-.234.702-.064 1.032.073.14.14.282.203.427.151.348.463.598.837.661l1.281.213c.542.09.94.56.94 1.11v2.592c0 .55-.398 1.02-.94 1.11l-1.281.213a1.125 1.125 0 0 0-.837.661c-.063.145-.13.287-.203.427-.17.33-.15.724.064 1.032l.732 1.055c.32.448.269 1.061-.12 1.45l-1.833 1.833a1.125 1.125 0 0 1-1.45.12l-1.055-.732a1.125 1.125 0 0 0-1.032-.064c-.14.073-.282.14-.427.203a1.125 1.125 0 0 0-.661.837l-.213 1.281c-.09.542-.56.94-1.11.94h-2.592c-.55 0-1.02-.398-1.11-.94l-.213-1.281a1.125 1.125 0 0 0-.661-.837 7.03 7.03 0 0 1-.427-.203 1.125 1.125 0 0 0-1.032.064l-1.055.732a1.125 1.125 0 0 1-1.45-.12l-1.833-1.833a1.125 1.125 0 0 1-.12-1.45l.732-1.055c.214-.308.234-.702.064-1.032a7.03 7.03 0 0 1-.203-.427 1.125 1.125 0 0 0-.837-.661l-1.281-.213A1.125 1.125 0 0 1 1.5 15.958v-2.592c0-.55.398-1.02.94-1.11l1.281-.213c.374-.063.686-.313.837-.661.063-.145.13-.287.203-.427.17-.33.15-.724-.064-1.032L3.965 8.868a1.125 1.125 0 0 1 .12-1.45l1.833-1.833a1.125 1.125 0 0 1 1.45-.12l1.055.732c.308.214.702.234 1.032.064.14-.073.282-.14.427-.203.348-.151.598-.463.661-.837l.213-1.281Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      </a>
      {{#if canEdit}}
      <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">
        <span class="text-2xl leading-none">+</span>
        New item
      </a>
      {{/if}}
    </div>
  </header>

  {{#if sharedWardrobes.length}}
  <section class="mb-4">
    <select class="select select-bordered select-sm w-full max-w-sm border-slate-700 bg-slate-900" onchange="location.href=this.value">
      <option value="/wardrobe" {{#unless viewOwner}}selected{{/unless}}>{{t 'lang.MY_WARDROBE'}}</option>
      {{#each sharedWardrobes}}
      <option value="/wardrobe?ownerId={{this.grantorId}}" {{#ifEquals ../viewOwner this.grantorId}}selected{{/ifEquals}}>{{this.grantorName}} ({{this.permission}})</option>
      {{/each}}
    </select>
  </section>
  {{/if}}

  <nav class="mb-5 flex gap-8 overflow-x-auto border-b border-slate-800 text-sm sm:text-base">
    {{#each categoryTabs}}
    <a
      href="{{this.href}}"
      class="whitespace-nowrap border-b-2 px-1 pb-4 {{#if this.active}}border-emerald-400 text-white{{else}}border-transparent text-slate-400 hover:text-white{{/if}}"
    >
      {{this.label}}
    </a>
    {{/each}}
  </nav>

  <form method="get" action="/wardrobe" id="filter-form" class="mb-5 flex flex-wrap items-start gap-3">
    {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
    <input type="hidden" name="keyword" value="{{search.keyword}}">
    <input type="hidden" name="category" value="{{search.category}}">
    <input type="hidden" name="location" value="{{search.location}}">
    <input type="hidden" name="size" value="{{search.size}}">

    <details class="dropdown">
      <summary class="btn border-slate-700 bg-slate-900 text-slate-100 hover:bg-slate-800">
        {{categoryPanel.title}}
      </summary>
      <div class="dropdown-content z-30 mt-2 w-80 rounded-lg border border-slate-800 bg-slate-950 p-3 shadow-xl">
        {{#if categoryPanel.breadcrumbs.length}}
        <div class="mb-3 flex flex-wrap items-center gap-2 border-b border-slate-800 pb-3 text-xs text-slate-400">
          {{#each categoryPanel.breadcrumbs}}
          <a href="{{this.href}}" class="hover:text-emerald-300">{{this.label}}</a>
          {{#unless @last}}<span>/</span>{{/unless}}
          {{/each}}
        </div>
        {{else}}
        <div class="mb-3 border-b border-slate-800 pb-3 text-sm font-semibold text-white">Choose a category</div>
        {{/if}}
        <div class="space-y-1">
          {{#each categoryPanel.options}}
          <a href="{{this.href}}" class="flex items-center justify-between rounded-md px-3 py-3 text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200">
            <span>{{this.label}}</span>
            {{#if this.hasChildren}}<span class="text-slate-500">&gt;</span>{{/if}}
          </a>
          {{/each}}
        </div>
        {{#unless categoryPanel.options.length}}
        <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="block rounded-md px-3 py-3 text-sm text-slate-300 hover:bg-slate-800">
          Back
        </a>
        {{/unless}}
      </div>
    </details>

    <details class="dropdown">
      <summary class="btn border-slate-700 bg-slate-900 text-slate-100 hover:bg-slate-800">Size</summary>
      <div class="dropdown-content z-30 mt-2 max-h-96 w-96 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950 p-4 shadow-xl">
        {{#each dashboardSizeGroups}}
        <h3 class="mb-3 mt-2 font-semibold text-white">{{this.label}}</h3>
        <div class="mb-4 grid grid-cols-2 gap-2">
          {{#each this.sizes}}
          <a href="{{this.href}}" class="rounded-md border px-4 py-3 text-center {{#if this.active}}border-emerald-400 bg-emerald-500/15 text-emerald-100{{else}}border-slate-800 text-slate-200 hover:border-emerald-500 hover:bg-emerald-500/15{{/if}}">{{this.label}}</a>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </details>

    <select name="color" class="select select-bordered w-36 border-slate-700 bg-slate-900" onchange="this.form.submit()">
      <option value="">Colour</option>
      {{#each colors}}
      <option value="{{this}}" {{#ifEquals this ../search.color}}selected{{/ifEquals}}>{{this}}</option>
      {{/each}}
    </select>
    <select name="tag" class="select select-bordered w-36 border-slate-700 bg-slate-900" onchange="this.form.submit()">
      <option value="">Tags</option>
      {{#each availableTags}}
      <option value="{{this}}" {{#ifEquals this ../search.tag}}selected{{/ifEquals}}>{{this}}</option>
      {{/each}}
    </select>
  </form>

  {{#if filterChips.length}}
  <div class="mb-5 flex flex-wrap items-center gap-3">
    {{#each filterChips}}
    <a href="{{this.href}}" class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-100 hover:border-emerald-400 hover:bg-emerald-500/20">
      {{this.label}}
      <span class="text-lg leading-none text-slate-400">&times;</span>
    </a>
    {{/each}}
    <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="ml-auto text-sm text-cyan-300 hover:text-cyan-200">Clear filters</a>
  </div>
  {{/if}}

  {{#if availableLocations.length}}
  <nav class="mb-5 flex w-full max-w-3xl overflow-hidden rounded-lg border border-slate-800 bg-slate-900">
    <a href="{{allLocationsHref}}" class="min-w-36 flex-1 px-4 py-3 text-center text-sm {{#unless search.location}}bg-slate-800 text-white{{else}}text-slate-300{{/unless}}">
      All locations
    </a>
    {{#each locationTabs}}
    <a href="{{this.href}}" class="min-w-36 flex-1 border-l border-slate-800 px-4 py-3 text-center text-sm {{#if this.active}}bg-emerald-500/20 text-emerald-200{{else}}text-slate-300{{/if}}">
      {{this.label}}
    </a>
    {{/each}}
  </nav>
  {{/if}}

  {{#if categoryShortcuts.length}}
  <nav class="mb-8 flex max-w-3xl flex-wrap gap-x-8 gap-y-3 text-sm">
    {{#each categoryShortcuts}}
    <a href="{{this.href}}" class="text-emerald-400 hover:text-emerald-300">{{this.label}}</a>
    {{/each}}
  </nav>
  {{/if}}

  <div class="mb-4 flex items-center justify-between text-sm text-slate-400">
    <span>{{garments.length}} {{t 'lang.RESULTS'}}</span>
  </div>

  {{#if garments.length}}
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
    {{#each garments}}
    <a href="/wardrobe/{{this.id}}{{#if ../viewOwner}}?ownerId={{../viewOwner}}{{/if}}" class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-900/80 shadow-lg shadow-black/20 transition hover:border-emerald-500/60 {{#if this.archived}}opacity-50{{/if}}">
      <figure class="relative aspect-[4/3] bg-slate-950">
        {{#if this.photo}}
        <img src="/file/nobg/{{this.photo.fileName}}" alt="{{this.name}}" class="h-full w-full object-contain p-5 transition group-hover:scale-[1.02]" />
        {{else}}
        <div class="flex h-full w-full items-center justify-center text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-14">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M12 3v8.25" />
          </svg>
        </div>
        {{/if}}
      </figure>
      <div class="space-y-2 p-4">
        <h2 class="truncate text-lg font-semibold text-white">{{#if this.name}}{{this.name}}{{else}}Untitled item{{/if}}</h2>
        <p class="truncate text-sm text-slate-400">{{#if this.brand}}{{this.brand}}{{/if}}{{#if this.size}}<span class="px-2">.</span>{{this.size}}{{/if}}</p>
        <div class="flex flex-wrap gap-2 pt-1">
          {{#if this.location}}
          <span class="rounded-md bg-emerald-500/15 px-2.5 py-1 text-xs text-emerald-300">{{this.location}}</span>
          {{/if}}
          {{#each (splitCsv this.tags)}}
          <span class="rounded-md border px-2.5 py-1 text-xs" style="{{tagStyle this}}">{{this}}</span>
          {{/each}}
          {{#unless this.location}}
          {{#unless this.tags}}
          <span class="rounded-md bg-slate-800 px-2.5 py-1 text-xs text-slate-400">{{this.category}}</span>
          {{/unless}}
          {{/unless}}
        </div>
      </div>
    </a>
    {{/each}}
  </section>
  {{else}}
  <section class="flex min-h-[50vh] flex-col items-center justify-center gap-4 text-center text-slate-500">
    <p>{{t 'lang.NO_GARMENTS'}}</p>
    {{#if canEdit}}
    <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn bg-emerald-600 text-white hover:bg-emerald-500">{{t 'lang.ADD_FIRST_GARMENT'}}</a>
    {{/if}}
  </section>
  {{/if}}
</main>
