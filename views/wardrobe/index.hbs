<main class="wardrobe-dashboard min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <header class="dashboard-header mb-5 flex flex-col gap-4 border-b border-slate-800 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-9 text-emerald-400"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.125 15.367 10.128 11.99A3.78 3.78 0 0 1 12 11.5c.675 0 1.277.156 1.872.49l6.003 3.377A2.208 2.208 0 0 1 18.792 19.5H5.208a2.208 2.208 0 0 1-1.083-4.133Z"
        />
        <path
          stroke-linecap="round"
          d="M10 6.405A1.953 1.953 0 0 1 12 4.5c1.105 0 2 .853 2 1.905 0 .72-.419 1.346-1.038 1.67C12.473 8.331 12 8.757 12 9.31V11.5"
        />
      </svg>
      <div>
        <div class="text-2xl font-bold tracking-normal">
          Libre <span class="text-emerald-400">Closet</span>
        </div>
        <div class="text-sm text-slate-400">My wardrobe</div>
      </div>
    </div>

    <form method="get" action="/wardrobe" class="dashboard-search flex w-full max-w-2xl items-center gap-2 rounded-lg border border-slate-800 bg-slate-900 px-4 py-2 shadow-lg shadow-black/20">
      {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
      <input type="hidden" name="category" value="{{search.category}}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-slate-400">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
      </svg>
      <input
        type="text"
        name="keyword"
        value="{{search.keyword}}"
        placeholder="Search your wardrobe..."
        class="min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-slate-500"
      />
      <button type="submit" class="btn btn-ghost btn-sm border border-slate-700">Search</button>
    </form>

    <div class="dashboard-actions flex items-center gap-2">
      <a href="/wardrobe/settings" class="btn btn-ghost btn-square border border-slate-800 bg-slate-900 text-slate-200" title="Settings">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.592c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.661.837.145.063.287.13.427.203.33.17.724.15 1.032-.064l1.055-.732a1.125 1.125 0 0 1 1.45.12l1.833 1.833c.389.389.44 1.002.12 1.45l-.732 1.055c-.214.308-.234.702-.064 1.032.073.14.14.282.203.427.151.348.463.598.837.661l1.281.213c.542.09.94.56.94 1.11v2.592c0 .55-.398 1.02-.94 1.11l-1.281.213a1.125 1.125 0 0 0-.837.661c-.063.145-.13.287-.203.427-.17.33-.15.724.064 1.032l.732 1.055c.32.448.269 1.061-.12 1.45l-1.833 1.833a1.125 1.125 0 0 1-1.45.12l-1.055-.732a1.125 1.125 0 0 0-1.032-.064c-.14.073-.282.14-.427.203a1.125 1.125 0 0 0-.661.837l-.213 1.281c-.09.542-.56.94-1.11.94h-2.592c-.55 0-1.02-.398-1.11-.94l-.213-1.281a1.125 1.125 0 0 0-.661-.837 7.03 7.03 0 0 1-.427-.203 1.125 1.125 0 0 0-1.032.064l-1.055.732a1.125 1.125 0 0 1-1.45-.12l-1.833-1.833a1.125 1.125 0 0 1-.12-1.45l.732-1.055c.214-.308.234-.702.064-1.032a7.03 7.03 0 0 1-.203-.427 1.125 1.125 0 0 0-.837-.661l-1.281-.213A1.125 1.125 0 0 1 1.5 15.958v-2.592c0-.55.398-1.02.94-1.11l1.281-.213c.374-.063.686-.313.837-.661.063-.145.13-.287.203-.427.17-.33.15-.724-.064-1.032L3.965 8.868a1.125 1.125 0 0 1 .12-1.45l1.833-1.833a1.125 1.125 0 0 1 1.45-.12l1.055.732c.308.214.702.234 1.032.064.14-.073.282-.14.427-.203.348-.151.598-.463.661-.837l.213-1.281Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      </a>
      {{#if canEdit}}
      <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">
        <span class="text-2xl leading-none">+</span>
        New item
      </a>
      {{/if}}
    </div>
  </header>

  {{#if sharedWardrobes.length}}
  <section class="mb-4">
    <select class="select select-bordered select-sm w-full max-w-sm border-slate-700 bg-slate-900" onchange="location.href=this.value">
      <option value="/wardrobe" {{#unless viewOwner}}selected{{/unless}}>{{t 'lang.MY_WARDROBE'}}</option>
      {{#each sharedWardrobes}}
      <option value="/wardrobe?ownerId={{this.grantorId}}" {{#ifEquals ../viewOwner this.grantorId}}selected{{/ifEquals}}>{{this.grantorName}} ({{this.permission}})</option>
      {{/each}}
    </select>
  </section>
  {{/if}}

  <nav class="dashboard-category-tabs mb-5 flex gap-8 overflow-x-auto border-b border-slate-800 text-sm sm:text-base">
    {{#each categoryTabs}}
    <a
      href="{{this.href}}"
      class="whitespace-nowrap border-b-2 px-1 pb-4 {{#if this.active}}border-emerald-400 text-white{{else}}border-transparent text-slate-400 hover:text-white{{/if}}"
    >
      {{this.label}}
    </a>
    {{/each}}
  </nav>

  <div class="dashboard-filter-row mb-5 flex flex-wrap items-start justify-between gap-3">
    <form method="get" action="/wardrobe" id="filter-form" class="dashboard-filters flex flex-wrap items-start gap-3">
      {{#if viewOwner}}<input type="hidden" name="ownerId" value="{{viewOwner}}">{{/if}}
      <input type="hidden" name="keyword" value="{{search.keyword}}">
      <input type="hidden" name="category" value="{{search.category}}">
      <input type="hidden" name="location" value="{{search.location}}">
      <input type="hidden" name="size" value="{{search.size}}">

    <div class="dashboard-category-filter relative">
      <button type="button" id="dashboardCategoryButton" class="btn border-slate-700 bg-slate-900 text-slate-100 hover:bg-slate-800">
        <span id="dashboardCategoryLabel">{{categoryPanel.title}}</span>
        <span class="text-slate-500">&gt;</span>
      </button>
      <div id="dashboardCategoryPanel" class="absolute left-0 top-full z-40 mt-2 hidden w-80 rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
        <div id="dashboardCategoryBreadcrumbs" class="mb-2 flex flex-wrap items-center gap-2 border-b border-slate-800 px-2 pb-2 text-xs text-slate-400"></div>
        <div id="dashboardCategoryOptions" class="max-h-80 overflow-y-auto"></div>
      </div>
    </div>

    <details class="dropdown">
      <summary class="btn border-slate-700 bg-slate-900 text-slate-100 hover:bg-slate-800">Size</summary>
      <div class="dropdown-content z-30 mt-2 max-h-96 w-96 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950 p-4 shadow-xl">
        <a href="{{sizeNoneHref}}" class="mb-3 block rounded-md border border-slate-800 px-4 py-3 text-center text-slate-200 hover:border-emerald-500 hover:bg-emerald-500/15">None</a>
        {{#each dashboardSizeGroups}}
        <h3 class="mb-3 mt-2 font-semibold text-white">{{this.label}}</h3>
        <div class="mb-4 grid grid-cols-2 gap-2">
          {{#each this.sizes}}
          <a href="{{this.href}}" class="rounded-md border px-4 py-3 text-center {{#if this.active}}border-emerald-400 bg-emerald-500/15 text-emerald-100{{else}}border-slate-800 text-slate-200 hover:border-emerald-500 hover:bg-emerald-500/15{{/if}}">{{this.label}}</a>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </details>

    <details class="dropdown dashboard-color-filter">
      <summary class="btn min-w-36 justify-between border-slate-700 bg-slate-900 text-slate-100 hover:bg-slate-800">
        <span>{{#if activeColors.length}}{{join activeColors ', '}}{{else}}Colour{{/if}}</span>
        <span class="text-slate-500">v</span>
      </summary>
      <div class="dropdown-content z-30 mt-2 max-h-96 w-56 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
        <a href="{{colorNoneHref}}" class="mb-1 flex items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200">
          <span>None</span>
          {{#unless activeColors.length}}<span class="text-emerald-300">selected</span>{{/unless}}
        </a>
        {{#each dashboardColors}}
        <a href="{{this.href}}" class="flex items-center justify-between rounded-md px-3 py-2 text-left text-sm {{#if this.active}}bg-emerald-500/15 text-emerald-100{{else}}text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200{{/if}}">
          <span class="inline-flex items-center gap-2"><span class="size-3 rounded-full border border-white/40" style="{{colorDotStyle this.label}}"></span>{{this.label}}</span>
          {{#if this.active}}<span class="text-emerald-300">selected</span>{{/if}}
        </a>
        {{/each}}
      </div>
    </details>
    <select name="tag" class="select select-bordered w-36 border-slate-700 bg-slate-900" onchange="this.form.submit()">
      <option value="" {{#unless search.tag}}selected{{/unless}} hidden>Tags</option>
      <option value="">None</option>
      {{#each availableTags}}
      <option value="{{this}}" {{#ifEquals this ../search.tag}}selected{{/ifEquals}}>{{this}}</option>
      {{/each}}
    </select>
  </form>

    <div class="dashboard-scale flex justify-end">
      <label class="flex items-center gap-3 rounded-lg border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-300">
        <span class="whitespace-nowrap">Card size</span>
        <input id="wardrobeCardScale" type="range" min="180" max="620" step="20" value="320" class="range range-xs w-40" />
      </label>
    </div>
  </div>

  {{#if filterChips.length}}
  <div class="mb-5 flex flex-wrap items-center gap-3">
    {{#each filterChips}}
    <a href="{{this.href}}" class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-100 hover:border-emerald-400 hover:bg-emerald-500/20">
      {{this.label}}
      <span class="text-lg leading-none text-slate-400">&times;</span>
    </a>
    {{/each}}
    <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="ml-auto text-sm text-cyan-300 hover:text-cyan-200">Clear filters</a>
  </div>
  {{/if}}

  {{#if availableLocations.length}}
  <nav class="dashboard-location-tabs mb-5 flex w-full max-w-3xl overflow-hidden rounded-lg border border-slate-800 bg-slate-900">
    <a href="{{allLocationsHref}}" class="min-w-36 flex-1 px-4 py-3 text-center text-sm {{#unless search.location}}bg-slate-800 text-white{{else}}text-slate-300{{/unless}}">
      All locations
    </a>
    {{#each locationTabs}}
    <a href="{{this.href}}" class="min-w-36 flex-1 border-l border-slate-800 px-4 py-3 text-center text-sm {{#if this.active}}bg-emerald-500/20 text-emerald-200{{else}}text-slate-300{{/if}}">
      {{this.label}}
    </a>
    {{/each}}
  </nav>
  {{/if}}

  {{#if categoryShortcuts.length}}
  <nav class="dashboard-shortcuts mb-8 max-w-5xl text-sm">
    {{#each categoryShortcuts}}
    <a href="{{this.href}}" class="block text-emerald-400 hover:text-emerald-300">{{this.label}}</a>
    {{/each}}
  </nav>
  {{/if}}

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-400">
    <span>{{garments.length}} {{t 'lang.RESULTS'}}</span>
  </div>

  {{#if garments.length}}
  <section id="wardrobeGrid" class="dashboard-grid grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(var(--wardrobe-card-min, 320px), 1fr));">
    {{#each garments}}
    <a href="/wardrobe/{{this.id}}{{#if ../viewOwner}}?ownerId={{../viewOwner}}{{/if}}" class="wardrobe-card group overflow-hidden rounded-lg border border-slate-800 bg-slate-900/80 shadow-lg shadow-black/20 transition hover:border-emerald-500/60 {{#if this.archived}}opacity-50{{/if}}">
      <figure class="group/card-photo relative aspect-[4/3] bg-slate-950" data-card-gallery='{{{json this.galleryPhotos}}}'>
        {{#if this.location}}
        <span class="absolute left-3 top-3 z-10 rounded-md border border-emerald-500/30 bg-slate-950/80 px-2.5 py-1 text-xs font-medium text-emerald-300 shadow-lg shadow-black/30 backdrop-blur">
          {{this.location}}
        </span>
        {{/if}}
        {{#if this.photo}}
        <img data-card-photo src="/file/nobg/{{this.photo.fileName}}" alt="{{this.name}}" class="h-full w-full object-contain p-5 transition group-hover:scale-[1.02]" />
        <button type="button" data-card-prev class="absolute left-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-slate-950/55 text-white opacity-0 shadow-lg shadow-black/30 backdrop-blur transition hover:border-white/40 hover:bg-slate-950/80 hover:opacity-100 group-hover/card-photo:opacity-70">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <button type="button" data-card-next class="absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-slate-950/55 text-white opacity-0 shadow-lg shadow-black/30 backdrop-blur transition hover:border-white/40 hover:bg-slate-950/80 hover:opacity-100 group-hover/card-photo:opacity-70">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
        {{else}}
        <div class="flex h-full w-full items-center justify-center text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-14">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M12 3v8.25" />
          </svg>
        </div>
        {{/if}}
      </figure>
      <div class="space-y-2 p-4">
        <h2 class="truncate text-lg font-semibold text-white">{{#if this.name}}{{this.name}}{{else}}Untitled item{{/if}}</h2>
        <div class="flex items-center justify-between gap-3 text-sm text-slate-400">
          <p class="min-w-0 truncate">{{#if this.brand}}{{this.brand}}{{/if}}{{#if this.size}}<span class="px-2">.</span>{{this.size}}{{/if}}</p>
          <p class="shrink-0 truncate text-right text-emerald-300">{{#each (splitCategoryPath this.category)}}<span>{{this}}</span>{{#unless @last}}<span class="px-1 text-slate-500">></span>{{/unless}}{{/each}}</p>
        </div>
        <div class="flex min-h-7 items-end justify-between gap-3 pt-1">
          <div class="flex flex-wrap gap-2">
            {{#each (splitCsv this.tags)}}
            <span class="rounded-md border px-2.5 py-1 text-xs" style="{{tagStyle this}}">{{this}}</span>
            {{/each}}
          </div>
        </div>
      </div>
    </a>
    {{/each}}
  </section>
  {{else}}
  <section class="dashboard-empty-state flex min-h-[50vh] flex-col items-center justify-center gap-4 text-center text-slate-500">
    <p>{{t 'lang.NO_GARMENTS'}}</p>
    {{#if canEdit}}
    <a href="/wardrobe/new{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn bg-emerald-600 text-white hover:bg-emerald-500">{{t 'lang.ADD_FIRST_GARMENT'}}</a>
    {{/if}}
  </section>
  {{/if}}

  <script>
    (() => {
      const categoryTree = {{{json categoryTree}}};
      const form = document.getElementById('filter-form');
      const categoryInput = form?.querySelector('input[name="category"]');
      const button = document.getElementById('dashboardCategoryButton');
      const label = document.getElementById('dashboardCategoryLabel');
      const panel = document.getElementById('dashboardCategoryPanel');
      const breadcrumbs = document.getElementById('dashboardCategoryBreadcrumbs');
      const options = document.getElementById('dashboardCategoryOptions');
      if (!form || !categoryInput || !button || !label || !panel || !breadcrumbs || !options) return;

      const pathParts = (path) => path.split('>').map((part) => part.trim()).filter(Boolean);
      const findNode = (nodes, value) => {
        for (const node of nodes) {
          if (node.value === value) return node;
          const child = findNode(node.children || [], value);
          if (child) return child;
        }
        return null;
      };
      const childNodes = (parent = '') => parent ? findNode(categoryTree, parent)?.children || [] : categoryTree;
      const hasChildren = (path) => childNodes(path).length > 0;
      const setBrowsingLabel = (value) => {
        label.textContent = value || categoryInput.value || 'Category';
      };
      const render = (parent = '') => {
        setBrowsingLabel(parent);
        breadcrumbs.innerHTML = '';
        options.innerHTML = '';

        const rootButton = document.createElement('button');
        rootButton.type = 'button';
        rootButton.textContent = 'All';
        rootButton.className = 'hover:text-emerald-300';
        rootButton.dataset.categoryBrowse = '';
        breadcrumbs.appendChild(rootButton);

        pathParts(parent).forEach((crumb, index, parts) => {
          breadcrumbs.append(' / ');
          const value = parts.slice(0, index + 1).join(' > ');
          const crumbButton = document.createElement('button');
          crumbButton.type = 'button';
          crumbButton.textContent = crumb;
          crumbButton.className = 'hover:text-emerald-300';
          crumbButton.dataset.categoryBrowse = value;
          breadcrumbs.appendChild(crumbButton);
        });

        const allOption = document.createElement('button');
        allOption.type = 'button';
        allOption.textContent = parent ? `Use ${parent}` : 'All categories';
        allOption.dataset.categorySelect = parent;
        allOption.className = 'mb-1 flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
        options.appendChild(allOption);

        for (const option of childNodes(parent)) {
          const optionHasChildren = hasChildren(option.value);
          const optionButton = document.createElement('button');
          optionButton.type = 'button';
          optionButton.dataset[optionHasChildren ? 'categoryBrowse' : 'categorySelect'] = option.value;
          optionButton.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
          const optionLabel = document.createElement('span');
          optionLabel.textContent = option.label;
          const arrow = document.createElement('span');
          arrow.className = 'text-slate-500';
          arrow.textContent = optionHasChildren ? '>' : '';
          optionButton.append(optionLabel, arrow);
          options.appendChild(optionButton);
        }
      };

      panel.addEventListener('click', (event) => {
        const target = event.target.closest('[data-category-browse], [data-category-select]');
        if (!target) return;
        event.preventDefault();
        event.stopPropagation();
        if (target.dataset.categoryBrowse !== undefined) {
          render(target.dataset.categoryBrowse);
          return;
        }
        categoryInput.value = target.dataset.categorySelect || '';
        form.submit();
      });

      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        panel.classList.toggle('hidden');
        render('');
      });

      document.addEventListener('click', (event) => {
        if (panel.classList.contains('hidden')) return;
        if (event.target.closest('#dashboardCategoryButton') || event.target.closest('#dashboardCategoryPanel')) return;
        panel.classList.add('hidden');
        label.textContent = categoryInput.value || 'Category';
      });
    })();

    (() => {
      const slider = document.getElementById('wardrobeCardScale');
      const grid = document.getElementById('wardrobeGrid');
      if (!slider || !grid) return;
      const stored = localStorage.getItem('wardrobeCardMin');
      const isMobile = window.matchMedia('(max-width: 640px)').matches;
      const mobileDefault = '180';
      const setSize = (value) => {
        const size = Math.max(180, Math.min(620, Number(value) || 320));
        slider.value = String(size);
        grid.style.setProperty('--wardrobe-card-min', `${size}px`);
        if (!isMobile) localStorage.setItem('wardrobeCardMin', String(size));
      };
      setSize(isMobile ? mobileDefault : stored || slider.value);
      slider.addEventListener('input', () => setSize(slider.value));
    })();
    (() => {
      const header = document.querySelector('.dashboard-header');
      if (!header) return;
      const sync = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 26);
      };
      sync();
      window.addEventListener('scroll', sync, { passive: true });
    })();
    (() => {
      for (const frame of document.querySelectorAll('[data-card-gallery]')) {
        let photos = [];
        try {
          photos = JSON.parse(frame.dataset.cardGallery || '[]');
        } catch {
          photos = [];
        }
        const img = frame.querySelector('[data-card-photo]');
        const prev = frame.querySelector('[data-card-prev]');
        const next = frame.querySelector('[data-card-next]');
        let index = 0;
        if (!img || photos.length <= 1) {
          prev?.classList.add('hidden');
          next?.classList.add('hidden');
          continue;
        }
        const show = (nextIndex) => {
          index = (nextIndex + photos.length) % photos.length;
          img.src = `/file/nobg/${photos[index].fileName}`;
        };
        prev?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          show(index - 1);
        });
        next?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          show(index + 1);
        });
      }
    })();
  </script>
</main>
