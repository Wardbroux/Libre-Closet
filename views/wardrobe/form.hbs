<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
    <div class="flex items-center justify-between gap-3">
      <a
        href="{{#if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{/if}}"
        class="btn btn-ghost btn-sm gap-2 text-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to all items
      </a>
    </div>

    <section class="flex flex-col gap-4">
      <div>
        <div class="mb-4 inline-flex rounded-lg border border-emerald-500/20 bg-emerald-500/15 px-4 py-2 text-sm font-medium text-emerald-200">
          New item
        </div>
        <h1 class="text-3xl font-bold tracking-normal text-white">
          {{#if isClone}}{{t 'lang.CLONE_GARMENT'}}{{else if garment}}{{t 'lang.EDIT_GARMENT'}}{{else}}New item{{/if}}
        </h1>
      </div>

      <form
        id="garmentForm"
        method="POST"
        {{#unless garment}}enctype="multipart/form-data"{{/unless}}
        action="{{#if isClone}}/wardrobe/{{garment.id}}/clone{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{/if}}"
        class="divide-y divide-slate-800 rounded-lg border border-slate-800 bg-slate-950/50"
      >
        {{#unless garment}}
        <div class="grid gap-4 px-4 py-4 lg:grid-cols-[minmax(0,1fr)_160px]">
          <div>
            <div class="mb-3 text-slate-300">Photo</div>
            <div id="newPhotoPreview" class="hidden w-full max-w-xl rounded-lg border border-slate-700 bg-slate-900 p-3 shadow-2xl shadow-black/30">
              <div id="newPhotoList" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
            </div>
          </div>
          <div class="flex flex-col items-start gap-3 lg:items-end lg:self-end">
            <button type="button" id="addPhotoButton" class="flex aspect-square w-32 flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-slate-500 bg-slate-900/60 text-sm text-slate-300 hover:border-emerald-400 hover:text-emerald-200">
              <span class="text-3xl leading-none">+</span>
              Add photo
            </button>
            <input type="file" id="photoInput" name="photo" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp" multiple />
            <input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp,image/png" multiple />
            <button id="photoBtn" type="button" class="hidden" disabled>Prepare photo</button>
            <p id="newPhotoStatus" class="mt-2 text-sm text-slate-500"></p>
          </div>
        </div>
        {{/unless}}

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Name</div>
          <input name="name" value="{{#if isClone}}{{cloneName}}{{else if garment}}{{garment.name}}{{/if}}" placeholder="Puma High Top Sneakers" class="w-full max-w-sm justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
        </div>

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Location</div>
          <select name="location" class="w-full max-w-sm justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
            <option value="">Unassigned</option>
            {{#each availableLocations}}
            <option value="{{this}}" {{#ifEquals this ../garment.location}}selected{{/ifEquals}}>{{this}}</option>
            {{/each}}
          </select>
        </div>

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Category</div>
          <div class="relative w-full max-w-sm justify-self-end">
            <input type="hidden" name="category" id="categoryValueInput" value="{{#if garment}}{{garment.category}}{{/if}}" />
            <button type="button" id="categoryPickerButton" class="flex w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
              <span id="categoryPickerLabel">{{#if garment}}{{garment.category}}{{else}}Select category{{/if}}</span>
              <span class="text-slate-400">></span>
            </button>
            <div id="categoryPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
              <div id="categoryBreadcrumbs" class="mb-2 flex flex-wrap gap-2 border-b border-slate-800 pb-2 text-xs text-slate-400"></div>
              <div id="categoryPickerOptions" class="max-h-72 overflow-y-auto"></div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Brand</div>
          <input name="brand" value="{{#if garment}}{{garment.brand}}{{/if}}" placeholder="Puma" class="w-full max-w-sm justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
        </div>

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Colour</div>
          <div class="relative w-full max-w-sm justify-self-end">
            <input type="hidden" name="color" id="colorValueInput" value="{{#if garment}}{{formatColors garment.color}}{{/if}}" />
            <button type="button" id="colorPickerButton" class="flex min-h-10 w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
              <span id="colorPickerLabel" class="flex flex-wrap gap-2"></span>
              <span class="text-slate-400">></span>
            </button>
            <div id="colorPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
              <div class="max-h-72 overflow-y-auto">
                {{#each colors}}
                <button type="button" data-color="{{this}}" class="color-option flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200">
                  <span class="inline-flex items-center gap-2"><span class="size-3 rounded-full border border-white/40" style="{{colorDotStyle this}}"></span>{{this}}</span>
                  <span class="color-check text-xs text-emerald-300"></span>
                </button>
                {{/each}}
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Size</div>
          <select name="size" class="w-full max-w-sm justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
            <option value="">Select size</option>
            {{#each sizeGroups}}
            <optgroup label="{{this.label}}" data-size-kind="{{this.kind}}">
              {{#each this.sizes}}
              <option value="{{this}}" {{#ifEquals this ../../garment.size}}selected{{/ifEquals}}>{{this}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>
        </div>

        <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Tags</div>
          <div class="justify-self-end">
            <input type="hidden" name="tags" id="tagValueInput" value="{{#if garment}}{{garment.tags}}{{/if}}" />
            <div id="tagChipPicker" class="flex max-w-md flex-wrap justify-end gap-2">
              {{#each availableTags}}
              <button type="button" data-tag="{{this}}" class="tag-toggle rounded-md border px-3 py-1 text-sm transition" style="{{tagStyle this}}">
                {{this}}
              </button>
              {{/each}}
            </div>
            <div class="mt-2 flex justify-end gap-2">
              <input id="newTagInput" type="text" placeholder="New tag" class="w-40 rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-sm text-white outline-none focus:border-emerald-400" />
              <button id="addTagButton" type="button" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-emerald-400 hover:text-emerald-200">Add</button>
            </div>
          </div>
        </div>

        <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
          <div class="text-slate-300">Notes</div>
          <textarea name="notes" rows="3" placeholder="Comfortable everyday sneakers." class="w-full max-w-sm justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right text-white outline-none focus:border-emerald-400">{{#if garment}}{{garment.notes}}{{/if}}</textarea>
        </div>

        <div class="flex justify-end gap-3 px-4 py-4">
          <a href="{{#if garment}}/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{else}}/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}{{/if}}" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">Save item</button>
        </div>
      </form>
    </section>
  </div>

  {{#unless garment}}
  <div id="photoEditorModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 px-4 py-6 backdrop-blur-sm">
    <div class="grid max-h-full w-full max-w-4xl gap-4 overflow-y-auto rounded-lg border border-slate-700 bg-slate-950 p-4 shadow-2xl shadow-black/50 lg:grid-cols-[1fr_260px]">
      <div class="flex min-h-[360px] flex-col gap-3">
        <div id="photoDropZone" class="relative flex min-h-[320px] flex-1 cursor-pointer items-center justify-center overflow-hidden rounded-lg border border-dashed border-slate-600 bg-slate-900/70">
          <div id="photoDropHint" class="px-6 text-center text-slate-300">
            <div class="text-lg font-semibold text-white">Drop photo here</div>
            <div class="mt-2 text-sm text-slate-400">or use camera, gallery, or files</div>
          </div>
          <canvas id="photoEditorCanvas" class="hidden max-h-[68vh] max-w-full touch-none rounded-md"></canvas>
        </div>
        <input id="photoEditorFileInput" type="file" class="hidden" accept="image/*" />
        <input id="photoEditorCameraInput" type="file" class="hidden" accept="image/*" capture="environment" />
        <input id="photoEditorFilesInput" type="file" class="hidden" />
      </div>
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white">Photo</h2>
          <p id="photoEditorStatus" class="mt-1 text-sm text-slate-400">Choose camera, gallery, files, or drag a photo.</p>
        </div>
        <label class="grid gap-2 text-sm text-slate-300">
          Zoom
          <input id="photoZoomInput" type="range" min="1" max="3" step="0.01" value="1" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Left / right
          <input id="photoXInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Up / down
          <input id="photoYInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Rotate
          <input id="photoRotateInput" type="range" min="-180" max="180" step="1" value="0" class="range range-sm" />
        </label>
        <div class="mt-auto flex flex-col gap-2">
          <button type="button" id="photoEditorUpload" class="hidden rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15 lg:block">Upload</button>
          <div class="grid grid-cols-3 gap-2 lg:hidden">
            <button type="button" id="photoEditorCamera" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Camera</button>
            <button type="button" id="photoEditorChoose" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Gallery</button>
            <button type="button" id="photoEditorFiles" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Files</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="photoEditorCancel" class="rounded-lg border border-slate-700 px-3 py-2 font-semibold text-slate-200 hover:border-slate-500 hover:bg-slate-800">Cancel</button>
            <button type="button" id="photoEditorSave" class="rounded-lg border border-emerald-600 bg-emerald-600 px-3 py-2 font-semibold text-white hover:border-emerald-500 hover:bg-emerald-500 disabled:cursor-not-allowed disabled:border-slate-700 disabled:bg-slate-700 disabled:text-slate-400" disabled>Use photo</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/unless}}

  <script type="module">
    import { wireUpPhotoInput } from '/js/background-removal.js';

    const categoryTree = {{{json categoryTree}}};
    const categoryInput = document.getElementById('categoryValueInput');
    const categoryButton = document.getElementById('categoryPickerButton');
    const categoryLabel = document.getElementById('categoryPickerLabel');
    const categoryPanel = document.getElementById('categoryPickerPanel');
    const categoryBreadcrumbs = document.getElementById('categoryBreadcrumbs');
    const categoryOptions = document.getElementById('categoryPickerOptions');
    const sizeSelect = document.querySelector('select[name="size"]');
    const originalSizeGroups = sizeSelect
      ? [...sizeSelect.querySelectorAll('optgroup')].map((group) => ({
          label: group.label,
          kind: group.dataset.sizeKind,
          options: [...group.querySelectorAll('option')].map((option) => ({
            value: option.value,
            text: option.textContent,
          })),
        }))
      : [];

    const pathParts = (path) => path.split('>').map((part) => part.trim()).filter(Boolean);
    const findCategoryNode = (nodes, value) => {
      for (const node of nodes) {
        if (node.value === value) return node;
        const child = findCategoryNode(node.children || [], value);
        if (child) return child;
      }
      return null;
    };
    const childNodes = (parent = '') => parent ? findCategoryNode(categoryTree, parent)?.children || [] : categoryTree;
    const hasCategoryChildren = (path) => childNodes(path).length > 0;
    const syncCategoryLabel = () => {
      if (!categoryLabel || !categoryInput) return;
      categoryLabel.textContent = categoryInput.value || 'Select category';
    };
    const syncSizeOptions = () => {
      if (!sizeSelect || !categoryInput) return;
      const previousValue = sizeSelect.value;
      const wantsShoes = categoryInput.value.startsWith('Shoes');
      const wantedKind = wantsShoes ? 'shoes' : 'clothing';
      sizeSelect.innerHTML = '<option value="">Select size</option>';
      for (const group of originalSizeGroups.filter((group) => group.kind === wantedKind)) {
        const optgroup = document.createElement('optgroup');
        optgroup.label = group.label;
        optgroup.dataset.sizeKind = group.kind;
        for (const source of group.options) {
          const option = document.createElement('option');
          option.value = source.value;
          option.textContent = source.text;
          optgroup.appendChild(option);
        }
        sizeSelect.appendChild(optgroup);
      }
      sizeSelect.value = [...sizeSelect.options].some((option) => option.value === previousValue) ? previousValue : '';
    };
    const renderCategoryPicker = (parent = '') => {
      categoryOptions.innerHTML = '';
      categoryBreadcrumbs.innerHTML = '';
      const rootCrumb = document.createElement('button');
      rootCrumb.type = 'button';
      rootCrumb.textContent = 'All';
      rootCrumb.className = 'hover:text-emerald-300';
      rootCrumb.dataset.categoryBrowse = '';
      categoryBreadcrumbs.appendChild(rootCrumb);
      const crumbs = parent ? pathParts(parent) : [];
      crumbs.forEach((crumb, index) => {
        categoryBreadcrumbs.append(' / ');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = crumb;
        button.className = 'hover:text-emerald-300';
        button.dataset.categoryBrowse = crumbs.slice(0, index + 1).join(' > ');
        categoryBreadcrumbs.appendChild(button);
      });
      for (const option of childNodes(parent)) {
        const button = document.createElement('button');
        button.type = 'button';
        const hasChildren = hasCategoryChildren(option.value);
        if (hasChildren) button.dataset.categoryBrowse = option.value;
        else button.dataset.categorySelect = option.value;
        button.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
        button.append(document.createTextNode(option.label));
        const arrow = document.createElement('span');
        arrow.className = 'text-slate-500';
        arrow.textContent = hasChildren ? '>' : '';
        button.appendChild(arrow);
        categoryOptions.appendChild(button);
      }
    };
    categoryPanel?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const target = event.target.closest('[data-category-browse], [data-category-select]');
      if (!target) return;
      event.preventDefault();
      event.stopPropagation();
      if (target.dataset.categoryBrowse !== undefined) {
        renderCategoryPicker(target.dataset.categoryBrowse);
        return;
      }
      categoryInput.value = target.dataset.categorySelect;
      syncCategoryLabel();
      syncSizeOptions();
      categoryPanel.classList.add('hidden');
    });
    categoryButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      categoryPanel.classList.toggle('hidden');
      renderCategoryPicker('');
    });

    const colorInput = document.getElementById('colorValueInput');
    const colorButton = document.getElementById('colorPickerButton');
    const colorLabel = document.getElementById('colorPickerLabel');
    const colorPanel = document.getElementById('colorPickerPanel');
    const selectedColors = new Set((colorInput?.value || '').split(',').map((color) => color.trim()).filter(Boolean));
    const colorStyles = {
      red: '#ef4444', pink: '#ec4899', orange: '#f97316', yellow: '#facc15',
      green: '#22c55e', blue: '#3b82f6', purple: '#a855f7', black: '#111827',
      white: '#f8fafc', grey: '#94a3b8', beige: '#d6b98c', brown: '#92400e',
      gold: '#d4af37', silver: '#cbd5e1', pattern: 'linear-gradient(135deg, #22c55e 0 25%, #facc15 25% 50%, #3b82f6 50% 75%, #ec4899 75%)', other: '#64748b',
    };
    const colorSwatch = (color) => {
      const dot = document.createElement('span');
      dot.className = 'size-2.5 rounded-full border border-white/40';
      dot.style.background = colorStyles[color.toLowerCase()] || color;
      return dot;
    };
    const syncColors = () => {
      if (colorInput) colorInput.value = [...selectedColors].join(', ');
      colorLabel.innerHTML = '';
      if (!selectedColors.size) colorLabel.textContent = 'Select colours';
      for (const color of selectedColors) {
        const chip = document.createElement('span');
        chip.className = 'inline-flex items-center gap-2 rounded-md border border-slate-600 bg-slate-800 px-2 py-0.5 text-sm';
        chip.append(colorSwatch(color), document.createTextNode(color));
        colorLabel.appendChild(chip);
      }
      for (const option of document.querySelectorAll('.color-option')) {
        const selected = selectedColors.has(option.dataset.color);
        option.classList.toggle('bg-emerald-500/15', selected);
        option.querySelector('.color-check').textContent = selected ? 'selected' : '';
      }
    };
    colorButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      colorPanel.classList.toggle('hidden');
    });
    colorPanel?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const option = event.target.closest('.color-option');
      if (!option) return;
      event.preventDefault();
      event.stopPropagation();
      const color = option.dataset.color;
      if (selectedColors.has(color)) selectedColors.delete(color);
      else selectedColors.add(color);
      syncColors();
    });

    const tagInput = document.getElementById('tagValueInput');
    const tagPicker = document.getElementById('tagChipPicker');
    const newTagInput = document.getElementById('newTagInput');
    const addTagButton = document.getElementById('addTagButton');
    const selectedTags = new Set((tagInput?.value || '').split(',').map((tag) => tag.trim()).filter(Boolean));
    const syncTags = () => {
      if (tagInput) tagInput.value = [...selectedTags].join(',');
      for (const button of document.querySelectorAll('.tag-toggle')) {
        const selected = selectedTags.has(button.dataset.tag);
        button.classList.toggle('ring-2', selected);
        button.classList.toggle('ring-white/80', selected);
        button.classList.toggle('opacity-40', !selected);
      }
    };
    const addTag = (tag) => {
      const clean = tag.trim();
      if (!clean) return;
      selectedTags.add(clean);
      if (!document.querySelector(`.tag-toggle[data-tag="${CSS.escape(clean)}"]`)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.tag = clean;
        button.textContent = clean;
        button.className = 'tag-toggle rounded-md border border-emerald-500/40 bg-emerald-500/15 px-3 py-1 text-sm text-emerald-200 transition';
        tagPicker?.appendChild(button);
      }
      newTagInput.value = '';
      syncTags();
    };
    tagPicker?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest('.tag-toggle');
      if (!button) return;
      const tag = button.dataset.tag;
      if (selectedTags.has(tag)) selectedTags.delete(tag);
      else selectedTags.add(tag);
      syncTags();
    });
    addTagButton?.addEventListener('click', () => addTag(newTagInput.value));
    newTagInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      addTag(newTagInput.value);
    });

    const photoModal = document.getElementById('photoEditorModal');
    const photoDropZone = document.getElementById('photoDropZone');
    const photoDropHint = document.getElementById('photoDropHint');
    const photoCanvas = document.getElementById('photoEditorCanvas');
    const photoFileInput = document.getElementById('photoEditorFileInput');
    const photoCameraInput = document.getElementById('photoEditorCameraInput');
    const photoFilesInput = document.getElementById('photoEditorFilesInput');
    const photoChoose = document.getElementById('photoEditorChoose');
    const photoCamera = document.getElementById('photoEditorCamera');
    const photoFiles = document.getElementById('photoEditorFiles');
    const photoUpload = document.getElementById('photoEditorUpload');
    const photoSave = document.getElementById('photoEditorSave');
    const photoCancel = document.getElementById('photoEditorCancel');
    const photoStatus = document.getElementById('photoEditorStatus');
    const zoomInput = document.getElementById('photoZoomInput');
    const xInput = document.getElementById('photoXInput');
    const yInput = document.getElementById('photoYInput');
    const rotateInput = document.getElementById('photoRotateInput');
    const uploadInput = document.getElementById('photoInput');
    const nobgInput = document.getElementById('nobgPhotoInput');
    const newPhotoPreview = document.getElementById('newPhotoPreview');
    const newPhotoList = document.getElementById('newPhotoList');
    const newPhotoStatus = document.getElementById('newPhotoStatus');
    let photoImage = null;
    let photoObjectUrl = '';
    let photoDragging = false;
    let lastPointer = null;
    const activePointers = new Map();
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;
    const pendingPhotos = [];

    const setPhotoStatus = (text) => {
      if (photoStatus) photoStatus.textContent = text;
    };
    const resetPhotoControls = () => {
      if (zoomInput) zoomInput.value = '1';
      if (xInput) xInput.value = '0';
      if (yInput) yInput.value = '0';
      if (rotateInput) rotateInput.value = '0';
      activePointers.clear();
      photoDragging = false;
      lastPointer = null;
      pinchStartDistance = 0;
    };
    const drawImageToCanvas = (ctx, canvas, image) => {
      const rotation = (parseFloat(rotateInput?.value || '0') * Math.PI) / 180;
      const cos = Math.abs(Math.cos(rotation));
      const sin = Math.abs(Math.sin(rotation));
      const rotatedWidth = image.naturalWidth * cos + image.naturalHeight * sin;
      const rotatedHeight = image.naturalWidth * sin + image.naturalHeight * cos;
      const zoom = parseFloat(zoomInput?.value || '1');
      const baseScale = Math.min(canvas.width / rotatedWidth, canvas.height / rotatedHeight);
      const scale = baseScale * zoom;
      const x = canvas.width / 2 + (parseFloat(xInput?.value || '0') / 100) * canvas.width * 0.4;
      const y = canvas.height / 2 + (parseFloat(yInput?.value || '0') / 100) * canvas.height * 0.4;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.drawImage(image, (-image.naturalWidth * scale) / 2, (-image.naturalHeight * scale) / 2, image.naturalWidth * scale, image.naturalHeight * scale);
      ctx.restore();
    };
    const drawPhotoPreview = () => {
      if (!photoCanvas || !photoImage) return;
      const size = 900;
      photoCanvas.width = size;
      photoCanvas.height = size;
      const ctx = photoCanvas.getContext('2d');
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, size, size);
      drawImageToCanvas(ctx, photoCanvas, photoImage);
    };
    const loadPhotoBlob = async (blob) => {
      if (blob.type && !blob.type.startsWith('image/')) {
        setPhotoStatus('Please choose an image file.');
        return;
      }
      if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
      photoObjectUrl = URL.createObjectURL(blob);
      photoImage = new Image();
      await new Promise((resolve, reject) => {
        photoImage.onload = resolve;
        photoImage.onerror = reject;
        photoImage.src = photoObjectUrl;
      });
      resetPhotoControls();
      photoDropHint?.classList.add('hidden');
      photoCanvas?.classList.remove('hidden');
      if (photoSave) photoSave.disabled = false;
      setPhotoStatus('Frame the photo, then save it.');
      drawPhotoPreview();
    };
    const resetPhotoEditor = () => {
      photoImage = null;
      if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
      photoObjectUrl = '';
      if (photoFileInput) photoFileInput.value = '';
      if (photoCameraInput) photoCameraInput.value = '';
      if (photoFilesInput) photoFilesInput.value = '';
      photoDropHint?.classList.remove('hidden');
      photoCanvas?.classList.add('hidden');
      if (photoCanvas) {
        const ctx = photoCanvas.getContext('2d');
        ctx?.clearRect(0, 0, photoCanvas.width, photoCanvas.height);
      }
      if (photoSave) photoSave.disabled = true;
      resetPhotoControls();
    };
    const openPhotoModal = () => {
      resetPhotoEditor();
      photoModal?.classList.remove('hidden');
      photoModal?.classList.add('flex');
      setPhotoStatus('Choose camera, gallery, files, or drag a photo.');
    };
    const closePhotoModal = () => {
      photoModal?.classList.add('hidden');
      photoModal?.classList.remove('flex');
    };
    photoModal?.addEventListener('click', (event) => {
      if (event.target !== photoModal) return;
      closePhotoModal();
    });
    const exportPhotoFile = async () => {
      if (!photoImage) return null;
      const canvas = document.createElement('canvas');
      canvas.width = 1400;
      canvas.height = 1400;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      drawImageToCanvas(ctx, canvas, photoImage);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png', 0.95));
      return new File([blob], 'garment-photo.png', { type: 'image/png' });
    };
    const syncPendingPhotoInputs = () => {
      if (!uploadInput || !nobgInput) return;
      const photoDt = new DataTransfer();
      const nobgDt = new DataTransfer();
      for (const pending of pendingPhotos) {
        photoDt.items.add(pending.photoFile);
        if (pending.nobgFile) nobgDt.items.add(pending.nobgFile);
      }
      uploadInput.files = photoDt.files;
      nobgInput.files = nobgDt.files;
    };
    const renderPendingPhotos = () => {
      if (!newPhotoList) return;
      newPhotoList.innerHTML = '';
      pendingPhotos.forEach((pending, index) => {
        const tile = document.createElement('button');
        tile.type = 'button';
        tile.className = 'group relative aspect-square overflow-hidden rounded-lg border border-slate-700 bg-slate-950';
        tile.title = 'Remove photo';
        const img = document.createElement('img');
        img.src = pending.previewUrl;
        img.alt = '';
        img.className = 'h-full w-full object-contain p-2';
        const badge = document.createElement('span');
        badge.className = 'absolute left-2 top-2 rounded-md bg-slate-950/80 px-2 py-0.5 text-xs text-slate-200';
        badge.textContent = index === 0 ? 'Main' : String(index + 1);
        const remove = document.createElement('span');
        remove.className = 'absolute right-2 top-2 rounded-md bg-red-500/90 px-2 py-0.5 text-xs font-semibold text-white opacity-0 transition group-hover:opacity-100';
        remove.textContent = 'Remove';
        tile.append(img, badge, remove);
        tile.addEventListener('click', () => {
          const [removed] = pendingPhotos.splice(index, 1);
          if (removed?.previewUrl) URL.revokeObjectURL(removed.previewUrl);
          renderPendingPhotos();
          syncPendingPhotoInputs();
          if (newPhotoStatus) {
            newPhotoStatus.textContent = pendingPhotos.length
              ? `${pendingPhotos.length} photo${pendingPhotos.length === 1 ? '' : 's'} ready.`
              : '';
          }
          newPhotoPreview?.classList.toggle('hidden', pendingPhotos.length === 0);
        });
        newPhotoList.appendChild(tile);
      });
      newPhotoPreview?.classList.toggle('hidden', pendingPhotos.length === 0);
    };
    const waitForPhotoProcessing = () =>
      new Promise((resolve) => {
        uploadInput?.addEventListener('photo-processing-complete', resolve, { once: true });
      });
    const preparePhoto = async () => {
      const file = await exportPhotoFile();
      if (!file || !uploadInput) return;
      setPhotoStatus('Removing background... this can take a little while.');
      if (photoSave) photoSave.disabled = true;
      uploadInput.dataset.skipMaskEditor = 'true';
      const dt = new DataTransfer();
      dt.items.add(file);
      uploadInput.files = dt.files;
      const processing = waitForPhotoProcessing();
      uploadInput.dispatchEvent(new Event('change'));
      await processing;
      const nobgFile = nobgInput?.files?.[0];
      const previewFile = nobgFile || file;
      pendingPhotos.push({
        photoFile: file,
        nobgFile,
        previewUrl: URL.createObjectURL(previewFile),
      });
      syncPendingPhotoInputs();
      renderPendingPhotos();
      if (newPhotoStatus) {
        newPhotoStatus.textContent = `${pendingPhotos.length} photo${pendingPhotos.length === 1 ? '' : 's'} ready${nobgFile ? ' with background removed' : ''}.`;
      }
      closePhotoModal();
      if (photoSave) photoSave.disabled = false;
    };
    document.getElementById('addPhotoButton')?.addEventListener('click', openPhotoModal);
    photoUpload?.addEventListener('click', () => photoFileInput?.click());
    photoCamera?.addEventListener('click', () => photoCameraInput?.click());
    photoChoose?.addEventListener('click', () => photoFileInput?.click());
    photoFiles?.addEventListener('click', () => photoFilesInput?.click());
    photoDropZone?.addEventListener('click', (event) => {
      if (event.target === photoCanvas) return;
      photoFileInput?.click();
    });
    photoCanvas?.addEventListener('click', (event) => event.stopPropagation());
    photoCancel?.addEventListener('click', closePhotoModal);
    photoSave?.addEventListener('click', preparePhoto);
    photoFileInput?.addEventListener('change', async () => {
      const file = photoFileInput.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    photoCameraInput?.addEventListener('change', async () => {
      const file = photoCameraInput.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    photoFilesInput?.addEventListener('change', async () => {
      const file = photoFilesInput.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    for (const input of [zoomInput, xInput, yInput, rotateInput]) input?.addEventListener('input', drawPhotoPreview);
    photoDropZone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      photoDropZone.classList.add('border-emerald-400');
    });
    photoDropZone?.addEventListener('dragleave', () => photoDropZone.classList.remove('border-emerald-400'));
    photoDropZone?.addEventListener('drop', async (event) => {
      event.preventDefault();
      photoDropZone.classList.remove('border-emerald-400');
      const file = event.dataTransfer?.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    photoCanvas?.addEventListener('pointerdown', (event) => {
      event.stopPropagation();
      activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (activePointers.size === 2) {
        const points = [...activePointers.values()];
        pinchStartDistance = Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
        pinchStartZoom = parseFloat(zoomInput?.value || '1');
        photoDragging = false;
      } else {
        photoDragging = true;
        lastPointer = { x: event.clientX, y: event.clientY };
      }
      photoCanvas.setPointerCapture(event.pointerId);
    });
    photoCanvas?.addEventListener('pointermove', (event) => {
      if (activePointers.has(event.pointerId)) activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (activePointers.size === 2 && zoomInput && pinchStartDistance) {
        event.preventDefault();
        const points = [...activePointers.values()];
        const distance = Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
        zoomInput.value = String(Math.max(1, Math.min(3, pinchStartZoom * (distance / pinchStartDistance))));
        drawPhotoPreview();
        return;
      }
      if (!photoDragging || !lastPointer || !xInput || !yInput) return;
      const dx = event.clientX - lastPointer.x;
      const dy = event.clientY - lastPointer.y;
      xInput.value = String(Math.max(-100, Math.min(100, parseFloat(xInput.value) + dx / 3)));
      yInput.value = String(Math.max(-100, Math.min(100, parseFloat(yInput.value) + dy / 3)));
      lastPointer = { x: event.clientX, y: event.clientY };
      drawPhotoPreview();
    });
    const endPointer = (event) => {
      activePointers.delete(event.pointerId);
      photoDragging = false;
      lastPointer = null;
      pinchStartDistance = 0;
    };
    photoCanvas?.addEventListener('pointerup', endPointer);
    photoCanvas?.addEventListener('pointercancel', endPointer);
    photoCanvas?.addEventListener('wheel', (event) => {
      if (!zoomInput) return;
      event.preventDefault();
      event.stopPropagation();
      const next = parseFloat(zoomInput.value) + (event.deltaY < 0 ? 0.08 : -0.08);
      zoomInput.value = String(Math.max(1, Math.min(3, next)));
      drawPhotoPreview();
    }, { passive: false });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (!event.target.closest('#categoryPickerButton, #categoryPickerPanel')) categoryPanel?.classList.add('hidden');
      if (!event.target.closest('#colorPickerButton, #colorPickerPanel')) colorPanel?.classList.add('hidden');
    });
    document.getElementById('garmentForm')?.addEventListener('submit', (event) => {
      if (categoryInput?.value) return;
      event.preventDefault();
      categoryButton?.focus();
      categoryPanel?.classList.remove('hidden');
      renderCategoryPicker('');
    });
    document.getElementById('garmentForm')?.addEventListener('submit', () => {
      syncPendingPhotoInputs();
    });
    syncCategoryLabel();
    syncSizeOptions();
    syncColors();
    syncTags();
    wireUpPhotoInput();
  </script>
</main>
