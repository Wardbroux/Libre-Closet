<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto max-w-3xl">
    <div class="mb-6 flex items-center justify-between gap-3">
      <a href="/wardrobe" class="btn btn-ghost btn-sm gap-2 text-slate-100">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="size-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
          />
        </svg>
        Back to wardrobe
      </a>
    </div>

    <section class="mb-5 rounded-lg border border-slate-800 bg-slate-900/70 p-5">
      <div class="mb-5">
        <h1 class="text-2xl font-bold text-white">Settings</h1>
        <p class="mt-1 text-sm text-slate-400">
          Manage the places your items can live.
        </p>
      </div>

      <form method="POST" action="/wardrobe/settings/locations" class="mb-6 flex flex-col gap-3 sm:flex-row">
        <input
          type="text"
          name="name"
          required
          placeholder="Storage locker"
          class="input input-bordered flex-1 border-slate-700 bg-slate-950"
        />
        <button class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">
          Add location
        </button>
      </form>

      <div class="divide-y divide-slate-800 rounded-lg border border-slate-800">
        {{#each locations}}
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <span class="font-medium text-slate-100">{{this}}</span>
          <form method="POST" action="/wardrobe/settings/locations/delete">
            <input type="hidden" name="name" value="{{this}}" />
            <button class="btn btn-ghost btn-sm text-red-300 hover:bg-red-500/15">
              Remove
            </button>
          </form>
        </div>
        {{/each}}
      </div>
    </section>

    <section class="rounded-lg border border-slate-800 bg-slate-900/70 p-5">
      <div class="mb-5 flex items-start justify-between gap-3">
        <div>
          <h2 class="text-xl font-bold text-white">PIN lock</h2>
          <p class="mt-1 text-sm text-slate-400">
            {{#if pinConfigured}}Change the PIN used to unlock Libre Closet.{{else}}Add a PIN before installing this as a phone app.{{/if}}
          </p>
        </div>
        {{#if pinConfigured}}
        <form method="POST" action="/pin/lock">
          <button class="btn btn-outline btn-sm border-slate-600 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15">
            Lock now
          </button>
        </form>
        {{/if}}
      </div>

      {{#if pinError}}
      <div class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200">{{pinError}}</div>
      {{/if}}

      <form method="POST" action="/wardrobe/settings/pin" class="grid gap-3">
        {{#if pinConfigured}}
        <label class="grid gap-2 text-sm text-slate-300">
          Current PIN
          <input
            type="password"
            name="currentPin"
            inputmode="numeric"
            pattern="[0-9]*"
            autocomplete="current-password"
            class="input input-bordered border-slate-700 bg-slate-950"
            required
          />
        </label>
        {{/if}}
        <label class="grid gap-2 text-sm text-slate-300">
          {{#if pinConfigured}}New PIN{{else}}PIN{{/if}}
          <input
            type="password"
            name="newPin"
            inputmode="numeric"
            pattern="[0-9]*"
            minlength="4"
            maxlength="8"
            autocomplete="new-password"
            placeholder="4 to 8 numbers"
            class="input input-bordered border-slate-700 bg-slate-950"
            required
          />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Confirm PIN
          <input
            type="password"
            name="confirmPin"
            inputmode="numeric"
            pattern="[0-9]*"
            minlength="4"
            maxlength="8"
            autocomplete="new-password"
            class="input input-bordered border-slate-700 bg-slate-950"
            required
          />
        </label>
        <button class="btn mt-2 border-0 bg-emerald-600 text-white hover:bg-emerald-500">
          {{#if pinConfigured}}Change PIN{{else}}Set PIN{{/if}}
        </button>
      </form>
    </section>
  </div>
</main>
