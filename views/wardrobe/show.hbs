<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
    <div class="flex items-center justify-between gap-3">
      <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-ghost btn-sm gap-2 text-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to all items
      </a>
      {{#if canEdit}}
      <button id="editItemToggle" type="button" class="btn btn-outline btn-sm border-slate-600 bg-slate-900/70 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15">
        Edit item
      </button>
      {{/if}}
    </div>

    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(390px,0.9fr)]">
      <div class="flex flex-col gap-4">
        <figure class="relative aspect-square overflow-hidden rounded-lg border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30">
          {{#if garment.photo}}
          <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{garment.name}}" class="h-full w-full object-contain p-6" />
          {{else}}
          <div class="flex h-full w-full items-center justify-center text-slate-500">No photo</div>
          {{/if}}
        </figure>

        <div class="grid max-w-xl grid-cols-5 gap-3">
          <div class="aspect-square rounded-lg border border-emerald-400 bg-slate-900 p-2">
            {{#if garment.photo}}
            <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{garment.name}}" class="h-full w-full object-contain" />
            {{/if}}
          </div>
          {{#if canEdit}}
          <button type="button" class="edit-mode hidden flex aspect-square flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-slate-500 bg-slate-900/60 text-sm text-slate-300">
            <span class="text-3xl leading-none">+</span>
            Add photo
          </button>
          {{/if}}
        </div>

        {{#if canEdit}}
        <form
          id="photoUploadForm"
          hx-post="/wardrobe/{{garment.id}}/photo{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          hx-encoding="multipart/form-data"
          hx-indicator="#loading"
          hx-target="main"
          hx-select="main"
          hx-swap="outerHTML"
          class="edit-mode hidden rounded-lg border border-slate-800 bg-slate-900/70 p-4"
        >
          <div class="flex flex-wrap items-center gap-3">
            <input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp" />
            <input type="file" id="photoInput" name="photo" class="file-input file-input-bordered file-input-sm border-slate-700 bg-slate-950" accept="image/jpeg,image/png,image/gif,image/webp" />
            <button id="photoBtn" class="btn btn-outline btn-sm border-slate-700" disabled>{{#if garment.photo}}Update photo{{else}}Add photo{{/if}}</button>
            <span id="loading" class="htmx-indicator loading loading-ring loading-sm"></span>
          </div>
        </form>
        {{/if}}
      </div>

      <div class="flex flex-col gap-5">
        <div>
          <div class="mb-4 inline-flex rounded-lg border border-emerald-500/20 bg-emerald-500/15 px-4 py-2 text-sm font-medium text-emerald-200">
            {{categoryLabel}}
          </div>
          <h1 class="view-mode text-3xl font-bold tracking-normal text-white">
            {{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}
          </h1>
        </div>

        <form
          id="itemForm"
          method="POST"
          action="/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          class="divide-y divide-slate-800 rounded-lg border border-slate-800 bg-slate-950/50"
        >
          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Name</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}</div>
            <input name="name" value="{{garment.name}}" placeholder="Puma High Top Sneakers" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Location</div>
            <div class="view-mode justify-self-end rounded-lg border border-emerald-500/25 bg-emerald-500/15 px-4 py-2 font-medium text-emerald-200">{{#if garment.location}}{{garment.location}}{{else}}Unassigned{{/if}}</div>
            <select name="location" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Unassigned</option>
              {{#each availableLocations}}
              <option value="{{this}}" {{#ifEquals this ../garment.location}}selected{{/ifEquals}}>{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Category</div>
            <div class="view-mode flex flex-wrap items-center justify-end gap-2 text-emerald-200">
              {{#each (splitCategoryPath garment.category)}}<span>{{this}}</span>{{#unless @last}}<span class="text-slate-500">></span>{{/unless}}{{/each}}
            </div>
            <div class="edit-mode relative hidden w-full max-w-xs justify-self-end">
              <input type="hidden" name="category" id="categoryValueInput" value="{{garment.category}}" required />
              <button type="button" id="categoryPickerButton" class="flex w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
                <span id="categoryPickerLabel">{{garment.category}}</span>
                <span class="text-slate-400">></span>
              </button>
              <div id="categoryPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
                <div id="categoryBreadcrumbs" class="mb-2 flex flex-wrap gap-2 border-b border-slate-800 pb-2 text-xs text-slate-400"></div>
                <div id="categoryPickerOptions" class="max-h-72 overflow-y-auto"></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Brand</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.brand}}{{garment.brand}}{{else}}-{{/if}}</div>
            <input name="brand" value="{{garment.brand}}" placeholder="Puma" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Colour</div>
            <div class="view-mode flex flex-wrap justify-end gap-2">
              {{#each (splitCsv garment.color)}}<span class="rounded-md border border-slate-600 bg-slate-800 px-3 py-1 text-sm text-white">{{this}}</span>{{/each}}
            </div>
            <input name="color" value="{{formatColors garment.color}}" placeholder="Green, White" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Size</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.size}}{{garment.size}}{{else}}-{{/if}}</div>
            <select name="size" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Select size</option>
              {{#each sizeGroups}}
              <optgroup label="{{this.label}}" data-size-kind="{{this.kind}}">
                {{#each this.sizes}}
                <option value="{{this}}" {{#ifEquals this ../../garment.size}}selected{{/ifEquals}}>{{this}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
          </div>

          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Tags</div>
            <div class="view-mode flex flex-wrap justify-start gap-2 sm:justify-end">
              {{#each (splitCsv garment.tags)}}<span class="rounded-md border px-3 py-1 text-sm" style="{{tagStyle this}}">{{this}}</span>{{/each}}
              {{#unless garment.tags}}<span class="text-sm text-slate-500">No tags yet</span>{{/unless}}
            </div>
            <div class="edit-mode hidden justify-self-end">
              <input type="hidden" name="tags" id="tagValueInput" value="{{garment.tags}}" />
              <div id="tagChipPicker" class="flex max-w-md flex-wrap justify-end gap-2">
                {{#each availableTags}}
                <button type="button" data-tag="{{this}}" class="tag-toggle rounded-md border px-3 py-1 text-sm transition" style="{{tagStyle this}}">
                  {{this}}
                </button>
                {{/each}}
              </div>
              <div class="mt-2 flex justify-end gap-2">
                <input id="newTagInput" type="text" placeholder="New tag" class="w-40 rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-sm text-white outline-none focus:border-emerald-400" />
                <button id="addTagButton" type="button" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-emerald-400 hover:text-emerald-200">Add</button>
              </div>
            </div>
          </div>

          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Notes</div>
            <p class="view-mode justify-self-end rounded-lg border border-slate-800 bg-slate-900/70 px-4 py-3 text-slate-200">{{#if garment.notes}}{{garment.notes}}{{else}}-{{/if}}</p>
            <textarea name="notes" rows="2" placeholder="Comfortable everyday sneakers." class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right text-white outline-none focus:border-emerald-400">{{garment.notes}}</textarea>
          </div>

          <div class="edit-mode hidden flex justify-end gap-3 px-4 py-4">
            <button type="button" id="cancelEditItem" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">Save changes</button>
          </div>
        </form>
      </div>
    </section>

    {{#if canDelete}}
    <section class="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
      <h2 class="mb-4 text-lg font-semibold text-white">Actions</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <button class="btn btn-outline border-slate-700 text-slate-100 hover:border-amber-300 hover:bg-amber-500/15" hx-post="/wardrobe/{{garment.id}}/archive" hx-confirm="{{#if garment.archived}}{{t 'lang.CONFIRM_UNARCHIVE'}}{{else}}{{t 'lang.CONFIRM_ARCHIVE'}}{{/if}}" hx-indicator="#loading">
          {{#if garment.archived}}Unarchive item{{else}}Archive item{{/if}}
        </button>
        <button class="btn btn-outline border-red-500/40 text-red-300 hover:border-red-300 hover:bg-red-500/15" hx-delete="/wardrobe/{{garment.id}}" hx-confirm="{{t 'lang.CONFIRM_DELETE'}}" hx-indicator="#loading">
          Delete item
        </button>
      </div>
    </section>
    {{/if}}
  </div>

  <script type="module">
    import { wireUpPhotoInput } from '/js/background-removal.js';

    const setEditing = (editing) => {
      for (const el of document.querySelectorAll('.view-mode')) {
        el.classList.toggle('hidden', editing);
      }
      for (const el of document.querySelectorAll('.edit-mode')) {
        el.classList.toggle('hidden', !editing);
      }
      const toggle = document.getElementById('editItemToggle');
      if (toggle) toggle.textContent = editing ? 'Editing' : 'Edit item';
    };

    document.getElementById('editItemToggle')?.addEventListener('click', () => setEditing(true));
    document.getElementById('cancelEditItem')?.addEventListener('click', () => setEditing(false));

    const categoryPaths = {{{json categoryPaths}}};
    const categoryInput = document.getElementById('categoryValueInput');
    const categoryButton = document.getElementById('categoryPickerButton');
    const categoryLabel = document.getElementById('categoryPickerLabel');
    const categoryPanel = document.getElementById('categoryPickerPanel');
    const categoryBreadcrumbs = document.getElementById('categoryBreadcrumbs');
    const categoryOptions = document.getElementById('categoryPickerOptions');
    const sizeSelect = document.querySelector('select[name="size"]');

    const pathParts = (path) => path.split('>').map((part) => part.trim()).filter(Boolean);
    const pathLeaf = (path) => pathParts(path).at(-1) || path || 'Category';
    const childLabels = (parent) => {
      if (!parent) return ['Clothing', 'Shoes', 'Bags', 'Accessories', 'Other'];
      const parentParts = parent ? pathParts(parent) : [];
      const labels = [];
      for (const path of categoryPaths) {
        const parts = pathParts(path);
        if (parent === 'Clothing') {
          if (['Accessories', 'Bags', 'Other', 'Shoes'].includes(parts[0])) continue;
          if (!labels.includes(parts[0])) labels.push(parts[0]);
          continue;
        }
        const matches = parentParts.every((part, index) => parts[index] === part);
        if (!matches || parts.length <= parentParts.length) continue;
        const next = parts[parentParts.length];
        if (!labels.includes(next)) labels.push(next);
      }
      return labels;
    };
    const hasCategoryChildren = (path) => childLabels(path).length > 0;
    const syncCategoryLabel = () => {
      if (!categoryLabel || !categoryInput) return;
      categoryLabel.textContent = categoryInput.value || 'Category';
    };
    const setBrowsingCategoryLabel = (value) => {
      if (!categoryLabel || !value) return;
      categoryLabel.textContent = value;
    };
    const syncSizeOptions = () => {
      if (!sizeSelect || !categoryInput) return;
      const wantsShoes = categoryInput.value.startsWith('Shoes');
      for (const group of sizeSelect.querySelectorAll('optgroup')) {
        const isShoeGroup = group.dataset.sizeKind === 'shoes';
        group.hidden = wantsShoes ? !isShoeGroup : isShoeGroup;
        for (const option of group.querySelectorAll('option')) {
          option.disabled = group.hidden;
        }
      }
      const selectedOption = sizeSelect.selectedOptions[0];
      if (selectedOption?.parentElement?.hidden) sizeSelect.value = '';
    };
    const renderCategoryPicker = (parent = '') => {
      if (!categoryOptions || !categoryBreadcrumbs) return;
      setBrowsingCategoryLabel(parent || categoryInput?.value || 'Category');
      categoryOptions.innerHTML = '';
      categoryBreadcrumbs.innerHTML = '';

      const crumbs = parent ? pathParts(parent) : [];
      const rootCrumb = document.createElement('button');
      rootCrumb.type = 'button';
      rootCrumb.textContent = 'All';
      rootCrumb.className = 'hover:text-emerald-300';
      rootCrumb.addEventListener('click', () => renderCategoryPicker(''));
      categoryBreadcrumbs.appendChild(rootCrumb);
      crumbs.forEach((crumb, index) => {
        categoryBreadcrumbs.append(' / ');
        const value = crumbs.slice(0, index + 1).join(' > ');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = crumb;
        button.className = 'hover:text-emerald-300';
        button.addEventListener('click', () => renderCategoryPicker(value));
        categoryBreadcrumbs.appendChild(button);
      });

      for (const label of childLabels(parent)) {
        const value = parent === 'Clothing' ? label : parent ? `${parent} > ${label}` : label;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
        const labelSpan = document.createElement('span');
        labelSpan.textContent = label;
        const arrowSpan = document.createElement('span');
        arrowSpan.className = 'text-slate-500';
        arrowSpan.textContent = hasCategoryChildren(value) ? '>' : '';
        button.append(labelSpan, arrowSpan);
        button.addEventListener('click', () => {
          if (hasCategoryChildren(value)) {
            renderCategoryPicker(value);
            return;
          }
          categoryInput.value = value;
          syncCategoryLabel();
          syncSizeOptions();
          categoryPanel?.classList.add('hidden');
        });
        categoryOptions.appendChild(button);
      }
    };

    categoryButton?.addEventListener('click', () => {
      categoryPanel?.classList.toggle('hidden');
      renderCategoryPicker('');
    });
    document.addEventListener('click', (event) => {
      if (!categoryPanel || categoryPanel.classList.contains('hidden')) return;
      if (event.target.closest('#categoryPickerButton') || event.target.closest('#categoryPickerPanel')) return;
      categoryPanel.classList.add('hidden');
      syncCategoryLabel();
    });
    syncCategoryLabel();
    syncSizeOptions();

    const tagInput = document.getElementById('tagValueInput');
    const tagPicker = document.getElementById('tagChipPicker');
    const newTagInput = document.getElementById('newTagInput');
    const addTagButton = document.getElementById('addTagButton');
    const selectedTags = new Set(
      (tagInput?.value || '')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean),
    );

    const syncTags = () => {
      if (tagInput) tagInput.value = [...selectedTags].join(',');
      for (const button of document.querySelectorAll('.tag-toggle')) {
        const selected = selectedTags.has(button.dataset.tag);
        button.classList.toggle('ring-2', selected);
        button.classList.toggle('ring-white/80', selected);
        button.classList.toggle('opacity-40', !selected);
      }
    };

    const addTag = (tag) => {
      const clean = tag.trim();
      if (!clean) return;
      selectedTags.add(clean);
      if (!document.querySelector(`.tag-toggle[data-tag="${CSS.escape(clean)}"]`)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.tag = clean;
        button.textContent = clean;
        button.className = 'tag-toggle rounded-md border border-emerald-500/40 bg-emerald-500/15 px-3 py-1 text-sm text-emerald-200 transition';
        tagPicker?.appendChild(button);
      }
      if (newTagInput) newTagInput.value = '';
      syncTags();
    };

    tagPicker?.addEventListener('click', (event) => {
      const button = event.target.closest('.tag-toggle');
      if (!button) return;
      const tag = button.dataset.tag;
      if (selectedTags.has(tag)) selectedTags.delete(tag);
      else selectedTags.add(tag);
      syncTags();
    });
    addTagButton?.addEventListener('click', () => addTag(newTagInput?.value || ''));
    newTagInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      addTag(newTagInput.value);
    });
    syncTags();
    wireUpPhotoInput();
  </script>
</main>
