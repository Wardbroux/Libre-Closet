        const formData = new FormData();
        formData.append('nobgPhoto', new File([editedBlob], 'nobg.webp', { type: 'image/webp' }));
        await fetch(`/wardrobe/{{garment.id}}/photos/${activePhotoId}/nobg{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}`, { method: 'POST', body: formData });
        const objectUrl = URL.createObjectURL(editedBlob);
        if (mainGarmentPhoto && activePhotoName) mainGarmentPhoto.src = objectUrl;
        const thumbImg = document.querySelector(`[data-photo-id="${CSS.escape(activePhotoId)}"] img`);
        if (thumbImg) thumbImg.src = objectUrl;
        setPhotoStatus('Mask updated.');
      } catch (err) {
        console.warn('[mask-editor] Failed:', err);
        setPhotoStatus('Could not update the mask.');
      } finally {
        photoMask.disabled = false;
      }
    });
    photoCamera?.addEventListener('click', () => photoCameraInput?.click());
    photoChoose?.addEventListener('click', () => photoFileInput?.click());
    photoFiles?.addEventListener('click', () => photoFilesInput?.click());
    photoDropZone?.addEventListener('click', (event) => {
      if (event.target === photoCanvas) return;
      photoFileInput?.click();
    });
    photoCanvas?.addEventListener('click', (event) => event.stopPropagation());
    photoCancel?.addEventListener('click', closePhotoModal);
    photoSave?.addEventListener('click', submitEditedPhoto);
    photoFileInput?.addEventListener('change', async () => {
      const file = photoFileInput.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    photoCameraInput?.addEventListener('change', async () => {
      const file = photoCameraInput.files?.[0];
