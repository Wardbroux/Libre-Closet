<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
    <div class="flex items-center justify-between gap-3">
      <a
        href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
        class="btn btn-ghost btn-sm gap-2 text-slate-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="size-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
          />
        </svg>
        Back to all items
      </a>
      {{#if canEdit}}
      <button
        id="editItemToggle"
        type="button"
        class="btn btn-outline btn-sm border-slate-600 bg-slate-900/70 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15"
      >
        Edit item
      </button>
      {{/if}}
    </div>

    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(390px,0.9fr)]">
      <div class="flex flex-col gap-4">
        <figure
          class="relative aspect-square overflow-hidden rounded-lg border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30"
        >
          {{#if garment.photo}}
          <img
            src="/file/nobg/{{garment.photo.fileName}}"
            alt="{{garment.name}}"
            class="h-full w-full object-contain p-6"
          />
          {{else}}
          <div class="flex h-full w-full items-center justify-center text-slate-500">
            No photo
          </div>
          {{/if}}
        </figure>

        <div class="grid max-w-xl grid-cols-5 gap-3">
          <div class="aspect-square rounded-lg border border-emerald-400 bg-slate-900 p-2">
            {{#if garment.photo}}
            <img
              src="/file/nobg/{{garment.photo.fileName}}"
              alt="{{garment.name}}"
              class="h-full w-full object-contain"
            />
            {{/if}}
          </div>
          {{#if canEdit}}
          <button
            type="button"
            class="flex aspect-square flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-slate-500 bg-slate-900/60 text-sm text-slate-300"
            onclick="document.getElementById('editItemPanel')?.classList.remove('hidden')"
          >
            <span class="text-3xl leading-none">+</span>
            Add photo
          </button>
          {{/if}}
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <div>
          <div class="mb-4 inline-flex rounded-lg border border-emerald-500/20 bg-emerald-500/15 px-4 py-2 text-sm font-medium text-emerald-200">
            {{categoryLabel}}
          </div>
          <h1 class="text-3xl font-bold tracking-normal text-white">
            {{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}
          </h1>
        </div>

        <div id="itemReadPanel" class="divide-y divide-slate-800 rounded-lg border border-slate-800 bg-slate-950/50">
          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Location</div>
            <div class="justify-self-end rounded-lg border border-emerald-500/25 bg-emerald-500/15 px-4 py-2 font-medium text-emerald-200">
              {{#if garment.location}}{{garment.location}}{{else}}Unassigned{{/if}}
            </div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Category</div>
            <div class="flex flex-wrap items-center justify-end gap-2 text-emerald-200">
              {{#each (splitCategoryPath garment.category)}}
              <span>{{this}}</span>{{#unless @last}}<span class="text-slate-500">></span>{{/unless}}
              {{/each}}
            </div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Brand</div>
            <div class="justify-self-end font-medium text-white">{{#if garment.brand}}{{garment.brand}}{{else}}-{{/if}}</div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Colour</div>
            <div class="flex flex-wrap justify-end gap-2">
              {{#each (splitCsv garment.color)}}
              <span class="rounded-md border border-slate-600 bg-slate-800 px-3 py-1 text-sm text-white">{{this}}</span>
              {{/each}}
            </div>
          </div>

          {{#if garment.size}}
          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Size</div>
            <div class="justify-self-end font-medium text-white">{{garment.size}}</div>
          </div>
          {{/if}}

          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Tags</div>
            <div class="flex flex-wrap justify-start gap-2 sm:justify-end">
              {{#each (splitCsv garment.tags)}}
              <span class="rounded-md border px-3 py-1 text-sm" style="{{tagStyle @index}}">{{this}}</span>
              {{/each}}
              {{#unless garment.tags}}
              <span class="text-sm text-slate-500">No tags yet</span>
              {{/unless}}
            </div>
          </div>

          {{#if garment.notes}}
          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Notes</div>
            <p class="rounded-lg border border-slate-800 bg-slate-900/70 p-4 text-slate-200">
              {{garment.notes}}
            </p>
          </div>
          {{/if}}
        </div>

        {{#if canEdit}}
        <section id="editItemPanel" class="hidden rounded-lg border border-emerald-500/30 bg-slate-900 p-4 shadow-lg shadow-emerald-950/20">
          <form
            method="POST"
            action="/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
            class="grid gap-4"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Name</span>
                <input name="name" value="{{garment.name}}" placeholder="Puma High Top Sneakers" class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Brand</span>
                <input name="brand" value="{{garment.brand}}" placeholder="Puma" class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Location</span>
                <input name="location" list="location-suggestions" value="{{garment.location}}" placeholder="Storage locker" class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Category</span>
                <input name="category" list="category-suggestions" value="{{garment.category}}" placeholder="Shoes > Sneakers" required class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Colour</span>
                <input name="color" value="{{formatColors garment.color}}" placeholder="Green, White" class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
              <label class="form-control">
                <span class="label-text mb-1 text-slate-300">Size</span>
                <input name="size" value="{{garment.size}}" placeholder="43 EU" class="input input-bordered border-slate-700 bg-slate-950" />
              </label>
            </div>
            <label class="form-control">
              <span class="label-text mb-1 text-slate-300">Tags</span>
              <input name="tags" value="{{garment.tags}}" placeholder="Hightop, Chunky, Platform, Casual" class="input input-bordered border-slate-700 bg-slate-950" />
            </label>
            <label class="form-control">
              <span class="label-text mb-1 text-slate-300">Notes</span>
              <textarea name="notes" rows="3" placeholder="Comfortable everyday sneakers." class="textarea textarea-bordered border-slate-700 bg-slate-950">{{garment.notes}}</textarea>
            </label>
            <datalist id="category-suggestions">
              {{#each categories}}
              <option value="{{this.value}}"></option>
              {{/each}}
            </datalist>
            <datalist id="location-suggestions">
              {{#each availableLocations}}
              <option value="{{this}}"></option>
              {{/each}}
            </datalist>
            <div class="flex justify-end gap-3">
              <button type="button" class="btn btn-ghost" onclick="document.getElementById('editItemPanel')?.classList.add('hidden')">Cancel</button>
              <button type="submit" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">Save changes</button>
            </div>
          </form>

          <form
            hx-post="/wardrobe/{{garment.id}}/photo{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
            hx-encoding="multipart/form-data"
            hx-indicator="#loading"
            hx-target="main"
            hx-select="main"
            hx-swap="outerHTML"
            class="mt-5 border-t border-slate-800 pt-4"
          >
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp" />
              <input type="file" id="photoInput" name="photo" class="file-input file-input-bordered file-input-sm border-slate-700 bg-slate-950" accept="image/jpeg,image/png,image/gif,image/webp" />
              <button id="photoBtn" class="btn btn-outline btn-sm border-slate-700" disabled>{{#if garment.photo}}Update photo{{else}}Add photo{{/if}}</button>
              <span id="loading" class="htmx-indicator loading loading-ring loading-sm"></span>
            </div>
          </form>
        </section>
        {{/if}}
      </div>
    </section>

    <section class="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
      <h2 class="mb-4 text-lg font-semibold text-white">Quick actions</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {{#if canClone}}
        <a
          href="/wardrobe/{{garment.id}}/clone{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          class="btn btn-outline border-slate-700 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15"
        >
          Clone item
        </a>
        {{/if}}
        {{#if canEdit}}
        <button
          class="btn btn-outline border-slate-700 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15"
          onclick="navigator.clipboard.writeText('{{siteUrl}}/share?shareableId={{garment.shareableId}}&type=garment'); alert('{{t 'lang.COPIED'}}')"
        >
          Share item
        </button>
        {{/if}}
        {{#if canDelete}}
        <button
          class="btn btn-outline border-slate-700 text-slate-100 hover:border-amber-300 hover:bg-amber-500/15"
          hx-post="/wardrobe/{{garment.id}}/archive"
          hx-confirm="{{#if garment.archived}}{{t 'lang.CONFIRM_UNARCHIVE'}}{{else}}{{t 'lang.CONFIRM_ARCHIVE'}}{{/if}}"
          hx-indicator="#loading"
        >
          {{#if garment.archived}}Unarchive item{{else}}Archive item{{/if}}
        </button>
        <button
          class="btn btn-outline border-red-500/40 text-red-300 hover:border-red-300 hover:bg-red-500/15"
          hx-delete="/wardrobe/{{garment.id}}"
          hx-confirm="{{t 'lang.CONFIRM_DELETE'}}"
          hx-indicator="#loading"
        >
          Delete item
        </button>
        {{/if}}
      </div>
    </section>
  </div>

  <script type="module">
    import { wireUpPhotoInput } from '/js/background-removal.js';

    document.getElementById('editItemToggle')?.addEventListener('click', () => {
      document.getElementById('editItemPanel')?.classList.toggle('hidden');
    });

    wireUpPhotoInput();
  </script>
</main>
