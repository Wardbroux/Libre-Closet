<main class="wardrobe-detail min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
    <div class="detail-topbar flex items-center justify-between gap-3">
      <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-ghost btn-sm gap-2 text-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to all items
      </a>
      <div class="flex items-center gap-2">
      {{#if canEdit}}
      <button id="editItemToggle" type="button" class="btn btn-outline btn-sm border-slate-600 bg-slate-900/70 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15">
        Edit item
      </button>
      {{/if}}
      {{#if canDelete}}
      <details class="dropdown dropdown-end">
        <summary class="btn btn-outline btn-sm btn-square border-slate-600 bg-slate-900/70 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15" title="More actions">
          <span class="sr-only">More actions</span>
          <span class="flex flex-col gap-1">
            <span class="block h-0.5 w-4 rounded bg-current"></span>
            <span class="block h-0.5 w-4 rounded bg-current"></span>
            <span class="block h-0.5 w-4 rounded bg-current"></span>
          </span>
        </summary>
        <div class="dropdown-content z-30 mt-2 w-56 rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
          <button class="w-full rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-amber-500/15 hover:text-amber-200" hx-post="/wardrobe/{{garment.id}}/archive" hx-confirm="{{#if garment.archived}}{{t 'lang.CONFIRM_UNARCHIVE'}}{{else}}{{t 'lang.CONFIRM_ARCHIVE'}}{{/if}}" hx-indicator="#loading">
            {{#if garment.archived}}Unarchive item{{else}}Archive item{{/if}}
          </button>
          <button class="mt-1 w-full rounded-md px-3 py-2 text-left text-sm text-red-300 hover:bg-red-500/15 hover:text-red-200" hx-delete="/wardrobe/{{garment.id}}" hx-confirm="{{t 'lang.CONFIRM_DELETE'}}" hx-indicator="#loading">
            Delete item
          </button>
        </div>
      </details>
      {{/if}}
      </div>
    </div>

    <section class="detail-layout grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(390px,0.9fr)]">
      <div class="detail-photo-column flex flex-col gap-4">
        <figure id="detailPhotoFrame" class="detail-photo-frame group/photo relative aspect-square overflow-hidden rounded-lg border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30">
          {{#if garment.photo}}
          <img id="mainGarmentPhoto" src="/file/nobg/{{garment.photo.fileName}}" alt="{{garment.name}}" class="h-full w-full object-contain p-6" />
          <button type="button" data-gallery-prev class="absolute inset-y-0 left-0 flex w-1/4 items-center justify-start bg-gradient-to-r from-slate-950/35 to-transparent pl-4 text-white opacity-0 transition hover:opacity-100 group-hover/photo:opacity-70">
            <span class="flex size-10 items-center justify-center rounded-full border border-white/15 bg-slate-950/55 shadow-lg shadow-black/30 backdrop-blur">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </span>
          </button>
          <button type="button" data-gallery-next class="absolute inset-y-0 right-0 flex w-1/4 items-center justify-end bg-gradient-to-l from-slate-950/35 to-transparent pr-4 text-white opacity-0 transition hover:opacity-100 group-hover/photo:opacity-70">
            <span class="flex size-10 items-center justify-center rounded-full border border-white/15 bg-slate-950/55 shadow-lg shadow-black/30 backdrop-blur">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          </button>
          {{else}}
          <div class="flex h-full w-full items-center justify-center text-slate-500">No photo</div>
          {{/if}}
        </figure>

        <div id="photoThumbList" class="detail-thumbs grid max-w-xl grid-cols-5 gap-3">
          {{#each galleryPhotos}}
          <button type="button" draggable="true" data-photo-thumb data-photo-id="{{this.id}}" data-photo-name="{{this.fileName}}" class="aspect-square rounded-lg border border-slate-700 bg-slate-900 p-2 text-left hover:border-emerald-400 data-[active=true]:border-emerald-400" {{#if @first}}data-active="true"{{/if}}>
            <img src="/file/nobg/{{this.fileName}}" alt="{{../garment.name}}" class="h-full w-full object-contain" />
          </button>
          {{/each}}
          {{#if canEdit}}
          <button type="button" id="addPhotoButton" class="edit-mode hidden flex aspect-square flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-slate-500 bg-slate-900/60 text-sm text-slate-300 hover:border-emerald-400 hover:text-emerald-200">
            <span class="text-3xl leading-none">+</span>
            Add photo
          </button>
          {{/if}}
        </div>

        {{#if canEdit}}
        <form
          id="photoUploadForm"
          hx-post="/wardrobe/{{garment.id}}/photo{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          hx-encoding="multipart/form-data"
          hx-indicator="#loading"
          hx-target="main"
          hx-select="main"
          hx-swap="outerHTML"
          class="hidden"
        >
          <input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp" />
          <input type="file" id="photoInput" name="photo" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp" />
          <input type="hidden" id="photoIdInput" name="photoId" value="" />
          <button id="photoBtn" class="hidden" disabled>{{#if garment.photo}}Update photo{{else}}Add photo{{/if}}</button>
        </form>
        {{/if}}
      </div>

      <div class="detail-info-column flex flex-col gap-5">
        <div id="detailSummaryHeader" class="view-mode">
          <div id="detailCategoryBadge" class="view-mode mb-4 inline-flex rounded-lg border border-emerald-500/20 bg-emerald-500/15 px-4 py-2 text-sm font-medium text-emerald-200">
            {{categoryLabel}}
          </div>
          <h1 class="view-mode text-3xl font-bold tracking-normal text-white">
            {{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}
          </h1>
        </div>

        <form
          id="itemForm"
          method="POST"
          action="/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          class="divide-y divide-slate-800 rounded-lg border border-slate-800 bg-slate-950/50"
        >
          <div class="edit-mode hidden grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Name</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}</div>
            <input name="name" value="{{garment.name}}" placeholder="Puma High Top Sneakers" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="optional-detail-row grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.location}}true{{/if}}">
            <div class="text-slate-300">Location</div>
            <div class="view-mode justify-self-end rounded-lg border border-emerald-500/25 bg-emerald-500/15 px-4 py-2 font-medium text-emerald-200">{{#if garment.location}}{{garment.location}}{{else}}Unassigned{{/if}}</div>
            <select name="location" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Unassigned</option>
              {{#each availableLocations}}
              <option value="{{this}}" {{#ifEquals this ../garment.location}}selected{{/ifEquals}}>{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div class="edit-mode hidden grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Category</div>
            <div class="view-mode flex flex-wrap items-center justify-end gap-2 text-emerald-200">
              {{#each (splitCategoryPath garment.category)}}<span>{{this}}</span>{{#unless @last}}<span class="text-slate-500">></span>{{/unless}}{{/each}}
            </div>
            <div class="edit-mode relative hidden w-full max-w-xs justify-self-end">
              <input type="hidden" name="category" id="categoryValueInput" value="{{garment.category}}" required />
              <button type="button" id="categoryPickerButton" class="flex w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
                <span id="categoryPickerLabel">{{garment.category}}</span>
                <span class="text-slate-400">></span>
              </button>
              <div id="categoryPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
                <div id="categoryBreadcrumbs" class="mb-2 flex flex-wrap gap-2 border-b border-slate-800 pb-2 text-xs text-slate-400"></div>
                <div id="categoryPickerOptions" class="max-h-72 overflow-y-auto"></div>
              </div>
            </div>
          </div>

          <div class="optional-detail-row grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.brand}}true{{/if}}">
            <div class="text-slate-300">Brand</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.brand}}{{garment.brand}}{{else}}-{{/if}}</div>
            <input name="brand" value="{{garment.brand}}" placeholder="Puma" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="optional-detail-row grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.color}}true{{/if}}">
            <div class="text-slate-300">Colour</div>
            <div class="view-mode flex flex-wrap justify-end gap-2">
              {{#each (splitCsv garment.color)}}<span class="inline-flex items-center gap-2 rounded-md border border-slate-600 bg-slate-800 px-3 py-1 text-sm text-white"><span class="size-2.5 rounded-full border border-white/40" style="{{colorDotStyle this}}"></span>{{this}}</span>{{/each}}
            </div>
            <div class="edit-mode relative hidden w-full max-w-xs justify-self-end">
              <input type="hidden" name="color" id="colorValueInput" value="{{formatColors garment.color}}" />
              <button type="button" id="colorPickerButton" class="flex min-h-10 w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
                <span id="colorPickerLabel" class="flex flex-wrap gap-2"></span>
                <span class="text-slate-400">></span>
              </button>
              <div id="colorPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
                <div class="max-h-72 overflow-y-auto">
                  {{#each colors}}
                  <button type="button" data-color="{{this}}" class="color-option flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200">
                    <span class="inline-flex items-center gap-2"><span class="size-3 rounded-full border border-white/40" style="{{colorDotStyle this}}"></span>{{this}}</span>
                    <span class="color-check text-emerald-300"></span>
                  </button>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>

          <div class="optional-detail-row grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.size}}true{{/if}}">
            <div class="text-slate-300">Size</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.size}}{{garment.size}}{{else}}-{{/if}}</div>
            <select name="size" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Select size</option>
              {{#each sizeGroups}}
              <optgroup label="{{this.label}}" data-size-kind="{{this.kind}}">
                {{#each this.sizes}}
                <option value="{{this}}" {{#ifEquals this ../../garment.size}}selected{{/ifEquals}}>{{this}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
          </div>

          <div class="optional-detail-row grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.tags}}true{{/if}}">
            <div class="text-slate-300">Tags</div>
            <div class="view-mode flex flex-wrap justify-start gap-2 sm:justify-end">
              {{#each (splitCsv garment.tags)}}<span class="rounded-md border px-3 py-1 text-sm" style="{{tagStyle this}}">{{this}}</span>{{/each}}
              {{#unless garment.tags}}<span class="text-sm text-slate-500">No tags yet</span>{{/unless}}
            </div>
            <div class="edit-mode hidden justify-self-end">
              <input type="hidden" name="tags" id="tagValueInput" value="{{garment.tags}}" />
              <div id="tagChipPicker" class="flex max-w-md flex-wrap justify-end gap-2">
                {{#each availableTags}}
                <button type="button" data-tag="{{this}}" class="tag-toggle rounded-md border px-3 py-1 text-sm transition" style="{{tagStyle this}}">
                  {{this}}
                </button>
                {{/each}}
              </div>
              <div class="mt-2 flex justify-end gap-2">
                <input id="newTagInput" type="text" placeholder="New tag" class="w-40 rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-sm text-white outline-none focus:border-emerald-400" />
                <button id="addTagButton" type="button" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-emerald-400 hover:text-emerald-200">Add</button>
              </div>
            </div>
          </div>

          <div class="optional-detail-row grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]" data-has-value="{{#if garment.notes}}true{{/if}}">
            <div class="text-slate-300">Notes</div>
            <p class="view-mode justify-self-end rounded-lg border border-slate-800 bg-slate-900/70 px-4 py-3 text-slate-200">{{#if garment.notes}}{{garment.notes}}{{else}}-{{/if}}</p>
            <textarea name="notes" rows="2" placeholder="Comfortable everyday sneakers." class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left text-white outline-none focus:border-emerald-400">{{garment.notes}}</textarea>
          </div>

          <div class="edit-mode hidden flex justify-end gap-3 px-4 py-4">
            <button type="button" id="cancelEditItem" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">Save changes</button>
          </div>
        </form>
      </div>
    </section>

  </div>

  {{#if canEdit}}
  <div id="photoEditorModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 px-4 py-6 backdrop-blur-sm">
    <div class="grid max-h-full w-full max-w-4xl gap-4 overflow-y-auto rounded-lg border border-slate-700 bg-slate-950 p-4 shadow-2xl shadow-black/50 lg:grid-cols-[1fr_260px]">
      <div class="flex min-h-[360px] flex-col gap-3">
        <div id="photoDropZone" class="relative flex min-h-[320px] flex-1 cursor-pointer items-center justify-center overflow-hidden rounded-lg border border-dashed border-slate-600 bg-slate-900/70">
          <div id="photoDropHint" class="px-6 text-center text-slate-300">
            <div class="text-lg font-semibold text-white">Drop photo here</div>
            <div class="mt-2 text-sm text-slate-400">or use camera, gallery, or files</div>
          </div>
          <canvas id="photoEditorCanvas" class="hidden max-h-[68vh] max-w-full touch-none rounded-md"></canvas>
        </div>
        <input id="photoEditorFileInput" type="file" class="hidden" accept="image/*" />
        <input id="photoEditorCameraInput" type="file" class="hidden" accept="image/*" capture="environment" />
        <input id="photoEditorFilesInput" type="file" class="hidden" />
      </div>
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white">Photo</h2>
          <p id="photoEditorStatus" class="mt-1 text-sm text-slate-400">Choose camera, gallery, files, or drag a photo.</p>
        </div>
        <label class="grid gap-2 text-sm text-slate-300">
          Zoom
          <input id="photoZoomInput" type="range" min="1" max="3" step="0.01" value="1" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Left / right
          <input id="photoXInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Up / down
          <input id="photoYInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Rotate
          <input id="photoRotateInput" type="range" min="-180" max="180" step="1" value="0" class="range range-sm" />
        </label>
        <div class="mt-auto border-t border-slate-800 pt-4">
          <div class="grid gap-2">
            <button type="button" id="photoEditorDelete" class="hidden rounded-lg border border-red-500/40 px-3 py-2 font-semibold text-red-300 hover:border-red-300 hover:bg-red-500/15">Remove photo</button>
            <button type="button" id="photoEditorMask" class="hidden rounded-lg border border-cyan-500/40 px-3 py-2 font-semibold text-cyan-200 hover:border-cyan-300 hover:bg-cyan-500/15 lg:block">Clean mask</button>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" id="photoEditorCamera" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Camera</button>
              <button type="button" id="photoEditorChoose" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Gallery</button>
              <button type="button" id="photoEditorFiles" class="rounded-lg border border-slate-600 px-3 py-2 font-semibold text-slate-100 hover:border-emerald-400 hover:bg-emerald-500/15">Files</button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" id="photoEditorCancel" class="rounded-lg border border-slate-700 px-3 py-2 font-semibold text-slate-200 hover:border-slate-500 hover:bg-slate-800">Cancel</button>
              <button type="button" id="photoEditorSave" class="rounded-lg border border-emerald-600 bg-emerald-600 px-3 py-2 font-semibold text-white hover:border-emerald-500 hover:bg-emerald-500 disabled:cursor-not-allowed disabled:border-slate-700 disabled:bg-slate-700 disabled:text-slate-400" disabled>Save photo</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <dialog id="maskEditorDialog" class="w-[min(92vw,980px)] rounded-lg border border-slate-700 bg-slate-950 p-0 text-slate-100 shadow-2xl shadow-black/60 backdrop:bg-slate-950/80">
    <div class="grid max-h-[90vh] gap-4 overflow-y-auto p-4 lg:grid-cols-[1fr_260px]">
      <div class="flex min-h-[420px] items-center justify-center overflow-hidden rounded-lg border border-slate-700 bg-slate-900">
        <canvas id="maskEditorCanvas" class="max-h-[76vh] max-w-full touch-none"></canvas>
      </div>
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white">Clean up background</h2>
          <p class="mt-1 text-sm text-slate-400">Erase bits you do not want, or restore parts that were removed.</p>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" id="maskBrushErase" class="btn btn-outline border-slate-600 bg-slate-900/70 text-slate-100">Erase</button>
          <button type="button" id="maskBrushRestore" class="btn btn-outline border-slate-600 bg-slate-900/70 text-slate-100">Restore</button>
        </div>
        <label class="grid gap-2 text-sm text-slate-300">
          Brush size
          <input id="maskBrushSize" type="range" min="4" max="90" step="1" value="24" class="range range-sm" />
        </label>
        <div class="mt-auto grid grid-cols-2 gap-2">
          <button type="button" id="maskEditorSkip" class="rounded-lg border border-slate-700 px-3 py-2 font-semibold text-slate-200 hover:border-slate-500 hover:bg-slate-800">Cancel</button>
          <button type="button" id="maskEditorAccept" class="rounded-lg border border-emerald-600 bg-emerald-600 px-3 py-2 font-semibold text-white hover:border-emerald-500 hover:bg-emerald-500">Apply</button>
        </div>
      </div>
    </div>
  </dialog>
  {{/if}}

  <script type="module">
    import { wireUpPhotoInput } from '/js/background-removal.js';
    import { openMaskEditor } from '/js/mask-editor.js';

    const setEditing = (editing) => {
      for (const el of document.querySelectorAll('.view-mode')) {
        el.classList.toggle('hidden', editing);
      }
      for (const el of document.querySelectorAll('.edit-mode')) {
        el.classList.toggle('hidden', !editing);
      }
      for (const el of document.querySelectorAll('.optional-detail-row')) {
        el.classList.toggle('hidden', !editing && el.dataset.hasValue !== 'true');
      }
      const detailCategoryBadge = document.getElementById('detailCategoryBadge');
      if (detailCategoryBadge) detailCategoryBadge.style.display = editing ? 'none' : 'inline-flex';
      const detailSummaryHeader = document.getElementById('detailSummaryHeader');
      if (detailSummaryHeader) detailSummaryHeader.style.display = editing ? 'none' : 'block';
      const toggle = document.getElementById('editItemToggle');
      if (toggle) toggle.classList.toggle('hidden', editing);
      document.body.dataset.itemEditing = editing ? 'true' : 'false';
    };

    document.getElementById('editItemToggle')?.addEventListener('click', () => setEditing(true));
    document.getElementById('cancelEditItem')?.addEventListener('click', () => setEditing(false));
    setEditing(false);

    const categoryTree = {{{json categoryTree}}};
    const categoryInput = document.getElementById('categoryValueInput');
    const categoryButton = document.getElementById('categoryPickerButton');
    const categoryLabel = document.getElementById('categoryPickerLabel');
    const categoryPanel = document.getElementById('categoryPickerPanel');
    const categoryBreadcrumbs = document.getElementById('categoryBreadcrumbs');
    const categoryOptions = document.getElementById('categoryPickerOptions');
    const sizeSelect = document.querySelector('select[name="size"]');
    const originalSizeGroups = sizeSelect
      ? [...sizeSelect.querySelectorAll('optgroup')].map((group) => ({
          label: group.label,
          kind: group.dataset.sizeKind,
          options: [...group.querySelectorAll('option')].map((option) => ({
            value: option.value,
            text: option.textContent,
          })),
        }))
      : [];

    const pathParts = (path) => path.split('>').map((part) => part.trim()).filter(Boolean);
    const findCategoryNode = (nodes, value) => {
      for (const node of nodes) {
        if (node.value === value) return node;
        const child = findCategoryNode(node.children || [], value);
        if (child) return child;
      }
      return null;
    };
    const childNodes = (parent = '') => {
      if (!parent) return categoryTree;
      return findCategoryNode(categoryTree, parent)?.children || [];
    };
    const hasCategoryChildren = (path) => childNodes(path).length > 0;
    const syncCategoryLabel = () => {
      if (!categoryLabel || !categoryInput) return;
      categoryLabel.textContent = categoryInput.value || 'Category';
    };
    const setBrowsingCategoryLabel = (value) => {
      if (!categoryLabel || !value) return;
      categoryLabel.textContent = value;
    };
    const syncSizeOptions = () => {
      if (!sizeSelect || !categoryInput) return;
      const previousValue = sizeSelect.value;
      const wantsShoes = categoryInput.value.startsWith('Shoes');
      const wantedKind = wantsShoes ? 'shoes' : 'clothing';
      sizeSelect.innerHTML = '<option value="">Select size</option>';
      for (const group of originalSizeGroups.filter((group) => group.kind === wantedKind)) {
        const optgroup = document.createElement('optgroup');
        optgroup.label = group.label;
        optgroup.dataset.sizeKind = group.kind;
        for (const source of group.options) {
          const option = document.createElement('option');
          option.value = source.value;
          option.textContent = source.text;
          optgroup.appendChild(option);
        }
        sizeSelect.appendChild(optgroup);
      }
      sizeSelect.value = [...sizeSelect.options].some((option) => option.value === previousValue) ? previousValue : '';
    };
    const renderCategoryPicker = (parent = '') => {
      if (!categoryOptions || !categoryBreadcrumbs) return;
      setBrowsingCategoryLabel(parent || categoryInput?.value || 'Category');
      categoryOptions.innerHTML = '';
      categoryBreadcrumbs.innerHTML = '';

      const crumbs = parent ? pathParts(parent) : [];
      const rootCrumb = document.createElement('button');
      rootCrumb.type = 'button';
      rootCrumb.textContent = 'All';
      rootCrumb.className = 'hover:text-emerald-300';
      rootCrumb.dataset.categoryBrowse = '';
      categoryBreadcrumbs.appendChild(rootCrumb);
      crumbs.forEach((crumb, index) => {
        categoryBreadcrumbs.append(' / ');
        const value = crumbs.slice(0, index + 1).join(' > ');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = crumb;
        button.className = 'hover:text-emerald-300';
        button.dataset.categoryBrowse = value;
        categoryBreadcrumbs.appendChild(button);
      });

      for (const option of childNodes(parent)) {
        const { label, value } = option;
        const hasChildren = hasCategoryChildren(value);
        const button = document.createElement('button');
        button.type = 'button';
        if (hasChildren) button.dataset.categoryBrowse = value;
        else button.dataset.categorySelect = value;
        button.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
        const labelSpan = document.createElement('span');
        labelSpan.textContent = label;
        const arrowSpan = document.createElement('span');
        arrowSpan.className = 'text-slate-500';
        arrowSpan.textContent = hasChildren ? '>' : '';
        button.append(labelSpan, arrowSpan);
        categoryOptions.appendChild(button);
      }
    };

    categoryPanel?.addEventListener('click', (event) => {
