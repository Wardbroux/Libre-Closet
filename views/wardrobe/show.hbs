    });
    photoDelete?.addEventListener('click', async () => {
      if (!activePhotoId || !confirm('Remove this photo?')) return;
      sessionStorage.setItem('libreClosetReturnToEdit', 'true');
      await fetch(`/wardrobe/{{garment.id}}/photos/${activePhotoId}/delete{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}`, { method: 'POST' });
      window.location.reload();
    });
    photoMask?.addEventListener('click', async () => {
      if (!activePhotoId || !activePhotoName) return;
      photoMask.disabled = true;
      setPhotoStatus('Opening mask editor...');
      try {
        const [origResp, nobgResp] = await Promise.all([
          fetch(`/file/${activePhotoName}`),
          fetch(`/file/nobg/${activePhotoName}`),
        ]);
        const [origBlob, nobgBlob] = await Promise.all([origResp.blob(), nobgResp.blob()]);
        const squareBlob = await squarePadBlob(origBlob);
        const editedBlob = await openMaskEditor(new File([squareBlob], activePhotoName, { type: 'image/png' }), nobgBlob);
        if (editedBlob === nobgBlob) {
          setPhotoStatus('Mask unchanged.');
          return;
