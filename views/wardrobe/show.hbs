    const photoIdInput = document.getElementById('photoIdInput');
    const uploadForm = document.getElementById('photoUploadForm');
    const mainGarmentPhoto = document.getElementById('mainGarmentPhoto');
    const photoDelete = document.getElementById('photoEditorDelete');
    const photoMask = document.getElementById('photoEditorMask');
    const galleryPhotos = {{{json galleryPhotos}}};
    let activePhotoName = '{{#if garment.photo}}{{garment.photo.fileName}}{{/if}}';
    let activePhotoId = galleryPhotos[0]?.id ? String(galleryPhotos[0].id) : '';
    let activePhotoIndex = 0;
    let photoImage = null;
    let photoObjectUrl = '';
    let photoDragging = false;
    let lastPointer = null;
    const activePointers = new Map();
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;

    const setPhotoStatus = (text) => {
      if (photoStatus) photoStatus.textContent = text;
    };
    const resetPhotoControls = () => {
      if (zoomInput) zoomInput.value = '1';
      if (xInput) xInput.value = '0';
      if (yInput) yInput.value = '0';
      if (rotateInput) rotateInput.value = '0';
      activePointers.clear();
      photoDragging = false;
      lastPointer = null;
      pinchStartDistance = 0;
    };
    const drawImageToCanvas = (ctx, canvas, image) => {
      const rotation = (parseFloat(rotateInput?.value || '0') * Math.PI) / 180;
      const cos = Math.abs(Math.cos(rotation));
      const sin = Math.abs(Math.sin(rotation));
      const rotatedWidth = image.naturalWidth * cos + image.naturalHeight * sin;
      const rotatedHeight = image.naturalWidth * sin + image.naturalHeight * cos;
      const zoom = parseFloat(zoomInput?.value || '1');
      const baseScale = Math.min(canvas.width / rotatedWidth, canvas.height / rotatedHeight);
      const scale = baseScale * zoom;
      const x = canvas.width / 2 + (parseFloat(xInput?.value || '0') / 100) * canvas.width * 0.4;
      const y = canvas.height / 2 + (parseFloat(yInput?.value || '0') / 100) * canvas.height * 0.4;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.drawImage(image, (-image.naturalWidth * scale) / 2, (-image.naturalHeight * scale) / 2, image.naturalWidth * scale, image.naturalHeight * scale);
      ctx.restore();
    };
    const drawPhotoPreview = () => {
      if (!photoCanvas || !photoImage) return;
      const size = 900;
      photoCanvas.width = size;
      photoCanvas.height = size;
      const ctx = photoCanvas.getContext('2d');
      ctx.clearRect(0, 0, size, size);
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, size, size);
      drawImageToCanvas(ctx, photoCanvas, photoImage);
    };
    const loadPhotoBlob = async (blob) => {
      if (blob.type && !blob.type.startsWith('image/')) {
        setPhotoStatus('Please choose an image file.');
        return;
      }
      if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
      photoObjectUrl = URL.createObjectURL(blob);
      photoImage = new Image();
      await new Promise((resolve, reject) => {
        photoImage.onload = resolve;
        photoImage.onerror = reject;
        photoImage.src = photoObjectUrl;
      });
      resetPhotoControls();
      photoDropHint?.classList.add('hidden');
      photoCanvas?.classList.remove('hidden');
      if (photoSave) photoSave.disabled = false;
      setPhotoStatus('Frame the photo, then save it.');
      drawPhotoPreview();
    };
    const resetPhotoEditor = () => {
      photoImage = null;
      if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
      photoObjectUrl = '';
      if (photoFileInput) photoFileInput.value = '';
      if (photoCameraInput) photoCameraInput.value = '';
      if (photoFilesInput) photoFilesInput.value = '';
      if (uploadInput) uploadInput.value = '';
      photoDropHint?.classList.remove('hidden');
      photoCanvas?.classList.add('hidden');
      if (photoCanvas) {
        const ctx = photoCanvas.getContext('2d');
        ctx?.clearRect(0, 0, photoCanvas.width, photoCanvas.height);
      }
      if (photoSave) photoSave.disabled = true;
      resetPhotoControls();
    };
    const squarePadBlob = async (blob) => {
      const bitmap = await createImageBitmap(blob);
      const size = Math.max(bitmap.width, bitmap.height);
      const canvas = new OffscreenCanvas(size, size);
      const ctx = canvas.getContext('2d');
      ctx.drawImage(bitmap, Math.floor((size - bitmap.width) / 2), Math.floor((size - bitmap.height) / 2));
      bitmap.close();
      return canvas.convertToBlob({ type: 'image/png' });
    };
    const selectGalleryPhoto = (index) => {
      if (!galleryPhotos.length) return;
      activePhotoIndex = (index + galleryPhotos.length) % galleryPhotos.length;
      const photo = galleryPhotos[activePhotoIndex];
      activePhotoName = photo.fileName;
      activePhotoId = String(photo.id);
      for (const thumb of document.querySelectorAll('[data-photo-thumb]')) {
        thumb.dataset.active = String(thumb.dataset.photoId === activePhotoId);
      }
      if (mainGarmentPhoto) mainGarmentPhoto.src = `/file/nobg/${activePhotoName}`;
    };
    const syncGalleryOrderFromThumbs = () => {
      const orderedIds = [...document.querySelectorAll('[data-photo-thumb]')].map((item) => String(item.dataset.photoId));
      galleryPhotos.sort((a, b) => orderedIds.indexOf(String(a.id)) - orderedIds.indexOf(String(b.id)));
      selectGalleryPhoto(0);
      return orderedIds;
    };
    const openPhotoModal = async ({ existing = false, photoName = '', photoId = '' } = {}) => {
      resetPhotoEditor();
      if (photoIdInput) photoIdInput.value = photoId;
      if (photoId) activePhotoId = String(photoId);
      if (photoName) activePhotoName = photoName;
      if (photoDelete) photoDelete.classList.toggle('hidden', !photoId);
      if (photoMask) photoMask.classList.toggle('hidden', !photoId);
      photoModal?.classList.remove('hidden');
      photoModal?.classList.add('flex');
      setPhotoStatus(existing ? 'Loading current photo...' : 'Choose camera, gallery, files, or drag a photo.');
      if (existing && photoName) {
        const response = await fetch(`/file/${photoName}`);
        await loadPhotoBlob(await response.blob());
      }
    };
    const closePhotoModal = () => {
      photoModal?.classList.add('hidden');
      photoModal?.classList.remove('flex');
    };
    const exportPhotoFile = async () => {
      if (!photoImage) return null;
      const canvas = document.createElement('canvas');
      canvas.width = 1400;
      canvas.height = 1400;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      drawImageToCanvas(ctx, canvas, photoImage);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png', 0.95));
      return new File([blob], 'garment-photo.png', { type: 'image/png' });
    };
    const waitForPhotoProcessing = () =>
      new Promise((resolve) => {
        uploadInput?.addEventListener('photo-processing-complete', resolve, { once: true });
      });
    const submitEditedPhoto = async () => {
      const file = await exportPhotoFile();
      if (!file || !uploadInput || !uploadForm) return;
      setPhotoStatus('Removing background... this can take a little while.');
      if (photoSave) photoSave.disabled = true;
      uploadInput.dataset.skipMaskEditor = 'true';
      const dt = new DataTransfer();
      dt.items.add(file);
      uploadInput.files = dt.files;
      const processing = waitForPhotoProcessing();
      uploadInput.dispatchEvent(new Event('change'));
      await processing;
      setPhotoStatus('Uploading photo...');
      closePhotoModal();
      sessionStorage.setItem('libreClosetReturnToEdit', 'true');
      uploadForm.requestSubmit();
    };

    document.getElementById('addPhotoButton')?.addEventListener('click', () => {
      activePhotoId = '';
      openPhotoModal();
    });
    for (const [index, thumb] of [...document.querySelectorAll('[data-photo-thumb]')].entries()) {
      thumb.addEventListener('click', () => {
        const photoName = thumb.dataset.photoName || '';
        const photoId = thumb.dataset.photoId || '';
        activePhotoName = photoName;
        activePhotoId = photoId;
        activePhotoIndex = galleryPhotos.findIndex((photo) => String(photo.id) === photoId);
        for (const other of document.querySelectorAll('[data-photo-thumb]')) {
          other.dataset.active = String(other === thumb);
        }
        if (mainGarmentPhoto && photoName) {
          mainGarmentPhoto.src = `/file/nobg/${photoName}`;
        }
        if (document.body.dataset.itemEditing !== 'true') return;
        openPhotoModal({ existing: true, photoName, photoId });
      });
      thumb.addEventListener('dragstart', (event) => {
        if (document.body.dataset.itemEditing !== 'true') {
          event.preventDefault();
          return;
        }
        event.dataTransfer?.setData('text/plain', thumb.dataset.photoId || '');
      });
      thumb.addEventListener('dragover', (event) => {
        if (document.body.dataset.itemEditing !== 'true') return;
        event.preventDefault();
      });
      thumb.addEventListener('drop', async (event) => {
        if (document.body.dataset.itemEditing !== 'true') return;
        event.preventDefault();
        const draggedId = event.dataTransfer?.getData('text/plain');
        if (!draggedId || draggedId === thumb.dataset.photoId) return;
        const list = document.getElementById('photoThumbList');
        const dragged = list?.querySelector(`[data-photo-id="${CSS.escape(draggedId)}"]`);
        if (!list || !dragged) return;
        list.insertBefore(dragged, thumb);
        const photoIds = syncGalleryOrderFromThumbs();
        await fetch('/wardrobe/{{garment.id}}/photos/reorder{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}', {
          method: 'POST',
