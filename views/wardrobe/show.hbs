<main class="min-h-screen bg-slate-950 px-4 py-5 text-slate-100 sm:px-8">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
    <div class="flex items-center justify-between gap-3">
      <a href="/wardrobe{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}" class="btn btn-ghost btn-sm gap-2 text-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to all items
      </a>
      {{#if canEdit}}
      <button id="editItemToggle" type="button" class="btn btn-outline btn-sm border-slate-600 bg-slate-900/70 text-slate-100 hover:border-emerald-300 hover:bg-emerald-500/15">
        Edit item
      </button>
      {{/if}}
    </div>

    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(390px,0.9fr)]">
      <div class="flex flex-col gap-4">
        <figure class="relative aspect-square overflow-hidden rounded-lg border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30">
          {{#if garment.photo}}
          <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{garment.name}}" class="h-full w-full object-contain p-6" />
          {{else}}
          <div class="flex h-full w-full items-center justify-center text-slate-500">No photo</div>
          {{/if}}
        </figure>

        <div class="grid max-w-xl grid-cols-5 gap-3">
          <button type="button" data-photo-edit-open="{{#if garment.photo}}true{{/if}}" class="aspect-square rounded-lg border border-emerald-400 bg-slate-900 p-2 text-left disabled:pointer-events-none" {{#unless garment.photo}}disabled{{/unless}}>
            {{#if garment.photo}}
            <img src="/file/nobg/{{garment.photo.fileName}}" alt="{{garment.name}}" class="h-full w-full object-contain" />
            {{/if}}
          </button>
          {{#if canEdit}}
          <button type="button" id="addPhotoButton" class="edit-mode hidden flex aspect-square flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-slate-500 bg-slate-900/60 text-sm text-slate-300 hover:border-emerald-400 hover:text-emerald-200">
            <span class="text-3xl leading-none">+</span>
            Add photo
          </button>
          {{/if}}
        </div>

        {{#if canEdit}}
        <form
          id="photoUploadForm"
          hx-post="/wardrobe/{{garment.id}}/photo{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          hx-encoding="multipart/form-data"
          hx-indicator="#loading"
          hx-target="main"
          hx-select="main"
          hx-swap="outerHTML"
          class="hidden"
        >
          <input type="file" id="nobgPhotoInput" name="nobgPhoto" class="hidden" accept="image/webp" />
          <input type="file" id="photoInput" name="photo" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp" />
          <button id="photoBtn" class="hidden" disabled>{{#if garment.photo}}Update photo{{else}}Add photo{{/if}}</button>
        </form>
        {{/if}}
      </div>

      <div class="flex flex-col gap-5">
        <div>
          <div class="mb-4 inline-flex rounded-lg border border-emerald-500/20 bg-emerald-500/15 px-4 py-2 text-sm font-medium text-emerald-200">
            {{categoryLabel}}
          </div>
          <h1 class="view-mode text-3xl font-bold tracking-normal text-white">
            {{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}
          </h1>
        </div>

        <form
          id="itemForm"
          method="POST"
          action="/wardrobe/{{garment.id}}{{#if viewOwner}}?ownerId={{viewOwner}}{{/if}}"
          class="divide-y divide-slate-800 rounded-lg border border-slate-800 bg-slate-950/50"
        >
          <div class="edit-mode hidden grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Name</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.name}}{{garment.name}}{{else}}Untitled item{{/if}}</div>
            <input name="name" value="{{garment.name}}" placeholder="Puma High Top Sneakers" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Location</div>
            <div class="view-mode justify-self-end rounded-lg border border-emerald-500/25 bg-emerald-500/15 px-4 py-2 font-medium text-emerald-200">{{#if garment.location}}{{garment.location}}{{else}}Unassigned{{/if}}</div>
            <select name="location" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Unassigned</option>
              {{#each availableLocations}}
              <option value="{{this}}" {{#ifEquals this ../garment.location}}selected{{/ifEquals}}>{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Category</div>
            <div class="view-mode flex flex-wrap items-center justify-end gap-2 text-emerald-200">
              {{#each (splitCategoryPath garment.category)}}<span>{{this}}</span>{{#unless @last}}<span class="text-slate-500">></span>{{/unless}}{{/each}}
            </div>
            <div class="edit-mode relative hidden w-full max-w-xs justify-self-end">
              <input type="hidden" name="category" id="categoryValueInput" value="{{garment.category}}" required />
              <button type="button" id="categoryPickerButton" class="flex w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
                <span id="categoryPickerLabel">{{garment.category}}</span>
                <span class="text-slate-400">></span>
              </button>
              <div id="categoryPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
                <div id="categoryBreadcrumbs" class="mb-2 flex flex-wrap gap-2 border-b border-slate-800 pb-2 text-xs text-slate-400"></div>
                <div id="categoryPickerOptions" class="max-h-72 overflow-y-auto"></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Brand</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.brand}}{{garment.brand}}{{else}}-{{/if}}</div>
            <input name="brand" value="{{garment.brand}}" placeholder="Puma" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400" />
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Colour</div>
            <div class="view-mode flex flex-wrap justify-end gap-2">
              {{#each (splitCsv garment.color)}}<span class="inline-flex items-center gap-2 rounded-md border border-slate-600 bg-slate-800 px-3 py-1 text-sm text-white"><span class="size-2.5 rounded-full border border-white/40" style="{{colorDotStyle this}}"></span>{{this}}</span>{{/each}}
            </div>
            <div class="edit-mode relative hidden w-full max-w-xs justify-self-end">
              <input type="hidden" name="color" id="colorValueInput" value="{{formatColors garment.color}}" />
              <button type="button" id="colorPickerButton" class="flex min-h-10 w-full items-center justify-between rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-left font-medium text-white outline-none hover:border-emerald-400">
                <span id="colorPickerLabel" class="flex flex-wrap gap-2"></span>
                <span class="text-slate-400">></span>
              </button>
              <div id="colorPickerPanel" class="absolute right-0 top-full z-40 mt-2 hidden w-full rounded-lg border border-slate-800 bg-slate-950 p-2 shadow-xl">
                <div class="max-h-72 overflow-y-auto">
                  {{#each colors}}
                  <button type="button" data-color="{{this}}" class="color-option flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200">
                    <span class="inline-flex items-center gap-2"><span class="size-3 rounded-full border border-white/40" style="{{colorDotStyle this}}"></span>{{this}}</span>
                    <span class="color-check text-emerald-300"></span>
                  </button>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-[120px_1fr] items-center gap-4 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Size</div>
            <div class="view-mode justify-self-end font-medium text-white">{{#if garment.size}}{{garment.size}}{{else}}-{{/if}}</div>
            <select name="size" class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right font-medium text-white outline-none focus:border-emerald-400">
              <option value="">Select size</option>
              {{#each sizeGroups}}
              <optgroup label="{{this.label}}" data-size-kind="{{this.kind}}">
                {{#each this.sizes}}
                <option value="{{this}}" {{#ifEquals this ../../garment.size}}selected{{/ifEquals}}>{{this}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
          </div>

          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Tags</div>
            <div class="view-mode flex flex-wrap justify-start gap-2 sm:justify-end">
              {{#each (splitCsv garment.tags)}}<span class="rounded-md border px-3 py-1 text-sm" style="{{tagStyle this}}">{{this}}</span>{{/each}}
              {{#unless garment.tags}}<span class="text-sm text-slate-500">No tags yet</span>{{/unless}}
            </div>
            <div class="edit-mode hidden justify-self-end">
              <input type="hidden" name="tags" id="tagValueInput" value="{{garment.tags}}" />
              <div id="tagChipPicker" class="flex max-w-md flex-wrap justify-end gap-2">
                {{#each availableTags}}
                <button type="button" data-tag="{{this}}" class="tag-toggle rounded-md border px-3 py-1 text-sm transition" style="{{tagStyle this}}">
                  {{this}}
                </button>
                {{/each}}
              </div>
              <div class="mt-2 flex justify-end gap-2">
                <input id="newTagInput" type="text" placeholder="New tag" class="w-40 rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-sm text-white outline-none focus:border-emerald-400" />
                <button id="addTagButton" type="button" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-emerald-400 hover:text-emerald-200">Add</button>
              </div>
            </div>
          </div>

          <div class="grid gap-3 px-4 py-4 sm:grid-cols-[160px_1fr]">
            <div class="text-slate-300">Notes</div>
            <p class="view-mode justify-self-end rounded-lg border border-slate-800 bg-slate-900/70 px-4 py-3 text-slate-200">{{#if garment.notes}}{{garment.notes}}{{else}}-{{/if}}</p>
            <textarea name="notes" rows="2" placeholder="Comfortable everyday sneakers." class="edit-mode hidden w-full max-w-xs justify-self-end rounded-lg border border-slate-700 bg-slate-950/70 px-3 py-2 text-right text-white outline-none focus:border-emerald-400">{{garment.notes}}</textarea>
          </div>

          <div class="edit-mode hidden flex justify-end gap-3 px-4 py-4">
            <button type="button" id="cancelEditItem" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500">Save changes</button>
          </div>
        </form>
      </div>
    </section>

    {{#if canDelete}}
    <section class="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
      <h2 class="mb-4 text-lg font-semibold text-white">Actions</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <button class="btn btn-outline border-slate-700 text-slate-100 hover:border-amber-300 hover:bg-amber-500/15" hx-post="/wardrobe/{{garment.id}}/archive" hx-confirm="{{#if garment.archived}}{{t 'lang.CONFIRM_UNARCHIVE'}}{{else}}{{t 'lang.CONFIRM_ARCHIVE'}}{{/if}}" hx-indicator="#loading">
          {{#if garment.archived}}Unarchive item{{else}}Archive item{{/if}}
        </button>
        <button class="btn btn-outline border-red-500/40 text-red-300 hover:border-red-300 hover:bg-red-500/15" hx-delete="/wardrobe/{{garment.id}}" hx-confirm="{{t 'lang.CONFIRM_DELETE'}}" hx-indicator="#loading">
          Delete item
        </button>
      </div>
    </section>
    {{/if}}
  </div>

  {{#if canEdit}}
  <div id="photoEditorModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 px-4 py-6 backdrop-blur-sm">
    <div class="grid max-h-full w-full max-w-4xl gap-4 overflow-y-auto rounded-lg border border-slate-700 bg-slate-950 p-4 shadow-2xl shadow-black/50 lg:grid-cols-[1fr_260px]">
      <div class="flex min-h-[360px] flex-col gap-3">
        <div id="photoDropZone" class="relative flex min-h-[320px] flex-1 cursor-pointer items-center justify-center overflow-hidden rounded-lg border border-dashed border-slate-600 bg-slate-900/70">
          <div id="photoDropHint" class="px-6 text-center text-slate-300">
            <div class="text-lg font-semibold text-white">Drop photo here</div>
            <div class="mt-2 text-sm text-slate-400">or click to upload</div>
          </div>
          <canvas id="photoEditorCanvas" class="hidden max-h-[68vh] max-w-full touch-none rounded-md"></canvas>
        </div>
        <input id="photoEditorFileInput" type="file" class="hidden" accept="image/jpeg,image/png,image/gif,image/webp" />
      </div>
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white">Photo</h2>
          <p id="photoEditorStatus" class="mt-1 text-sm text-slate-400">Upload or drag a photo, then frame it.</p>
        </div>
        <label class="grid gap-2 text-sm text-slate-300">
          Zoom
          <input id="photoZoomInput" type="range" min="1" max="3" step="0.01" value="1" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Left / right
          <input id="photoXInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <label class="grid gap-2 text-sm text-slate-300">
          Up / down
          <input id="photoYInput" type="range" min="-100" max="100" step="1" value="0" class="range range-sm" />
        </label>
        <div class="mt-auto flex justify-end gap-3">
          <button type="button" id="photoEditorCancel" class="btn btn-ghost">Cancel</button>
          <button type="button" id="photoEditorChoose" class="btn btn-outline border-slate-600">Upload</button>
          <button type="button" id="photoEditorSave" class="btn border-0 bg-emerald-600 text-white hover:bg-emerald-500" disabled>Save photo</button>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <script type="module">
    import { wireUpPhotoInput } from '/js/background-removal.js';

    const setEditing = (editing) => {
      for (const el of document.querySelectorAll('.view-mode')) {
        el.classList.toggle('hidden', editing);
      }
      for (const el of document.querySelectorAll('.edit-mode')) {
        el.classList.toggle('hidden', !editing);
      }
      const toggle = document.getElementById('editItemToggle');
      if (toggle) toggle.textContent = editing ? 'Editing' : 'Edit item';
    };

    document.getElementById('editItemToggle')?.addEventListener('click', () => setEditing(true));
    document.getElementById('cancelEditItem')?.addEventListener('click', () => setEditing(false));

    const categoryTree = {{{json categoryTree}}};
    const categoryInput = document.getElementById('categoryValueInput');
    const categoryButton = document.getElementById('categoryPickerButton');
    const categoryLabel = document.getElementById('categoryPickerLabel');
    const categoryPanel = document.getElementById('categoryPickerPanel');
    const categoryBreadcrumbs = document.getElementById('categoryBreadcrumbs');
    const categoryOptions = document.getElementById('categoryPickerOptions');
    const sizeSelect = document.querySelector('select[name="size"]');

    const pathParts = (path) => path.split('>').map((part) => part.trim()).filter(Boolean);
    const findCategoryNode = (nodes, value) => {
      for (const node of nodes) {
        if (node.value === value) return node;
        const child = findCategoryNode(node.children || [], value);
        if (child) return child;
      }
      return null;
    };
    const childNodes = (parent = '') => {
      if (!parent) return categoryTree;
      return findCategoryNode(categoryTree, parent)?.children || [];
    };
    const hasCategoryChildren = (path) => childNodes(path).length > 0;
    const syncCategoryLabel = () => {
      if (!categoryLabel || !categoryInput) return;
      categoryLabel.textContent = categoryInput.value || 'Category';
    };
    const setBrowsingCategoryLabel = (value) => {
      if (!categoryLabel || !value) return;
      categoryLabel.textContent = value;
    };
    const syncSizeOptions = () => {
      if (!sizeSelect || !categoryInput) return;
      const wantsShoes = categoryInput.value.startsWith('Shoes');
      for (const group of sizeSelect.querySelectorAll('optgroup')) {
        const isShoeGroup = group.dataset.sizeKind === 'shoes';
        group.hidden = wantsShoes ? !isShoeGroup : isShoeGroup;
        for (const option of group.querySelectorAll('option')) {
          option.disabled = group.hidden;
        }
      }
      const selectedOption = sizeSelect.selectedOptions[0];
      if (selectedOption?.parentElement?.hidden) sizeSelect.value = '';
    };
    const renderCategoryPicker = (parent = '') => {
      if (!categoryOptions || !categoryBreadcrumbs) return;
      setBrowsingCategoryLabel(parent || categoryInput?.value || 'Category');
      categoryOptions.innerHTML = '';
      categoryBreadcrumbs.innerHTML = '';

      const crumbs = parent ? pathParts(parent) : [];
      const rootCrumb = document.createElement('button');
      rootCrumb.type = 'button';
      rootCrumb.textContent = 'All';
      rootCrumb.className = 'hover:text-emerald-300';
      rootCrumb.dataset.categoryBrowse = '';
      categoryBreadcrumbs.appendChild(rootCrumb);
      crumbs.forEach((crumb, index) => {
        categoryBreadcrumbs.append(' / ');
        const value = crumbs.slice(0, index + 1).join(' > ');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = crumb;
        button.className = 'hover:text-emerald-300';
        button.dataset.categoryBrowse = value;
        categoryBreadcrumbs.appendChild(button);
      });

      for (const option of childNodes(parent)) {
        const { label, value } = option;
        const hasChildren = hasCategoryChildren(value);
        const button = document.createElement('button');
        button.type = 'button';
        if (hasChildren) button.dataset.categoryBrowse = value;
        else button.dataset.categorySelect = value;
        button.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-slate-200 hover:bg-emerald-500/15 hover:text-emerald-200';
        const labelSpan = document.createElement('span');
        labelSpan.textContent = label;
        const arrowSpan = document.createElement('span');
        arrowSpan.className = 'text-slate-500';
        arrowSpan.textContent = hasChildren ? '>' : '';
        button.append(labelSpan, arrowSpan);
        categoryOptions.appendChild(button);
      }
    };

    categoryPanel?.addEventListener('click', (event) => {
      const target = event.target.closest('[data-category-browse], [data-category-select]');
      if (!target) return;
      event.preventDefault();
      event.stopPropagation();
      const browseValue = target.dataset.categoryBrowse;
      if (browseValue !== undefined) {
        renderCategoryPicker(browseValue);
        return;
      }
      const selectValue = target.dataset.categorySelect;
      if (!selectValue || !categoryInput) return;
      categoryInput.value = selectValue;
      syncCategoryLabel();
      syncSizeOptions();
      categoryPanel.classList.add('hidden');
    });

    categoryButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      categoryPanel?.classList.toggle('hidden');
      renderCategoryPicker('');
    });
    document.addEventListener('click', (event) => {
      if (!categoryPanel || categoryPanel.classList.contains('hidden')) return;
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('#categoryPickerButton') || event.target.closest('#categoryPickerPanel')) return;
      categoryPanel.classList.add('hidden');
      syncCategoryLabel();
    });
    syncCategoryLabel();
    syncSizeOptions();

    const colorInput = document.getElementById('colorValueInput');
    const colorButton = document.getElementById('colorPickerButton');
    const colorLabel = document.getElementById('colorPickerLabel');
    const colorPanel = document.getElementById('colorPickerPanel');
    const selectedColors = new Set(
      (colorInput?.value || '')
        .split(',')
        .map((color) => color.trim())
        .filter(Boolean),
    );
    const colorStyles = {
      red: '#ef4444',
      pink: '#ec4899',
      orange: '#f97316',
      yellow: '#facc15',
      green: '#22c55e',
      blue: '#3b82f6',
      purple: '#a855f7',
      black: '#111827',
      white: '#f8fafc',
      grey: '#94a3b8',
      beige: '#d6b98c',
      brown: '#92400e',
      gold: '#d4af37',
      silver: '#cbd5e1',
      pattern: 'linear-gradient(135deg, #22c55e 0 25%, #facc15 25% 50%, #3b82f6 50% 75%, #ec4899 75%)',
      other: '#64748b',
    };
    const colorSwatch = (color) => {
      const dot = document.createElement('span');
      dot.className = 'size-2.5 rounded-full border border-white/40';
      dot.style.background = colorStyles[color.toLowerCase()] || color;
      return dot;
    };
    const syncColors = () => {
      if (colorInput) colorInput.value = [...selectedColors].join(', ');
      if (colorLabel) {
        colorLabel.innerHTML = '';
        if (!selectedColors.size) {
          colorLabel.textContent = 'Select colours';
        } else {
          for (const color of selectedColors) {
            const chip = document.createElement('span');
            chip.className = 'inline-flex items-center gap-2 rounded-md border border-slate-600 bg-slate-800 px-2 py-0.5 text-sm';
            chip.append(colorSwatch(color), document.createTextNode(color));
            colorLabel.appendChild(chip);
          }
        }
      }
      for (const option of document.querySelectorAll('.color-option')) {
        const selected = selectedColors.has(option.dataset.color);
        option.classList.toggle('bg-emerald-500/15', selected);
        option.querySelector('.color-check').textContent = selected ? 'selected' : '';
      }
    };
    colorButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      colorPanel?.classList.toggle('hidden');
    });
    colorPanel?.addEventListener('click', (event) => {
      const option = event.target.closest('.color-option');
      if (!option) return;
      event.preventDefault();
      event.stopPropagation();
      const color = option.dataset.color;
      if (selectedColors.has(color)) selectedColors.delete(color);
      else selectedColors.add(color);
      syncColors();
    });
    document.addEventListener('click', (event) => {
      if (!colorPanel || colorPanel.classList.contains('hidden')) return;
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('#colorPickerButton') || event.target.closest('#colorPickerPanel')) return;
      colorPanel.classList.add('hidden');
    });
    syncColors();

    const tagInput = document.getElementById('tagValueInput');
    const tagPicker = document.getElementById('tagChipPicker');
    const newTagInput = document.getElementById('newTagInput');
    const addTagButton = document.getElementById('addTagButton');
    const selectedTags = new Set(
      (tagInput?.value || '')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean),
    );

    const syncTags = () => {
      if (tagInput) tagInput.value = [...selectedTags].join(',');
      for (const button of document.querySelectorAll('.tag-toggle')) {
        const selected = selectedTags.has(button.dataset.tag);
        button.classList.toggle('ring-2', selected);
        button.classList.toggle('ring-white/80', selected);
        button.classList.toggle('opacity-40', !selected);
      }
    };

    const addTag = (tag) => {
      const clean = tag.trim();
      if (!clean) return;
      selectedTags.add(clean);
      if (!document.querySelector(`.tag-toggle[data-tag="${CSS.escape(clean)}"]`)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.tag = clean;
        button.textContent = clean;
        button.className = 'tag-toggle rounded-md border border-emerald-500/40 bg-emerald-500/15 px-3 py-1 text-sm text-emerald-200 transition';
        tagPicker?.appendChild(button);
      }
      if (newTagInput) newTagInput.value = '';
      syncTags();
    };

    tagPicker?.addEventListener('click', (event) => {
      const button = event.target.closest('.tag-toggle');
      if (!button) return;
      const tag = button.dataset.tag;
      if (selectedTags.has(tag)) selectedTags.delete(tag);
      else selectedTags.add(tag);
      syncTags();
    });
    addTagButton?.addEventListener('click', () => addTag(newTagInput?.value || ''));
    newTagInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      addTag(newTagInput.value);
    });
    syncTags();

    const photoModal = document.getElementById('photoEditorModal');
    const photoDropZone = document.getElementById('photoDropZone');
    const photoDropHint = document.getElementById('photoDropHint');
    const photoCanvas = document.getElementById('photoEditorCanvas');
    const photoFileInput = document.getElementById('photoEditorFileInput');
    const photoChoose = document.getElementById('photoEditorChoose');
    const photoSave = document.getElementById('photoEditorSave');
    const photoCancel = document.getElementById('photoEditorCancel');
    const photoStatus = document.getElementById('photoEditorStatus');
    const zoomInput = document.getElementById('photoZoomInput');
    const xInput = document.getElementById('photoXInput');
    const yInput = document.getElementById('photoYInput');
    const uploadInput = document.getElementById('photoInput');
    const uploadForm = document.getElementById('photoUploadForm');
    const existingPhotoName = '{{#if garment.photo}}{{garment.photo.fileName}}{{/if}}';
    let photoImage = null;
    let photoObjectUrl = '';
    let photoDragging = false;
    let lastPointer = null;

    const setPhotoStatus = (text) => {
      if (photoStatus) photoStatus.textContent = text;
    };
    const resetPhotoControls = () => {
      if (zoomInput) zoomInput.value = '1';
      if (xInput) xInput.value = '0';
      if (yInput) yInput.value = '0';
    };
    const drawPhotoPreview = () => {
      if (!photoCanvas || !photoImage) return;
      const size = 900;
      photoCanvas.width = size;
      photoCanvas.height = size;
      const ctx = photoCanvas.getContext('2d');
      ctx.clearRect(0, 0, size, size);
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, size, size);
      const zoom = parseFloat(zoomInput?.value || '1');
      const baseScale = Math.min(size / photoImage.naturalWidth, size / photoImage.naturalHeight);
      const scale = baseScale * zoom;
      const width = photoImage.naturalWidth * scale;
      const height = photoImage.naturalHeight * scale;
      const x = (size - width) / 2 + (parseFloat(xInput?.value || '0') / 100) * size * 0.4;
      const y = (size - height) / 2 + (parseFloat(yInput?.value || '0') / 100) * size * 0.4;
      ctx.drawImage(photoImage, x, y, width, height);
    };
    const loadPhotoBlob = async (blob) => {
      if (photoObjectUrl) URL.revokeObjectURL(photoObjectUrl);
      photoObjectUrl = URL.createObjectURL(blob);
      photoImage = new Image();
      await new Promise((resolve, reject) => {
        photoImage.onload = resolve;
        photoImage.onerror = reject;
        photoImage.src = photoObjectUrl;
      });
      resetPhotoControls();
      photoDropHint?.classList.add('hidden');
      photoCanvas?.classList.remove('hidden');
      if (photoSave) photoSave.disabled = false;
      setPhotoStatus('Frame the photo, then save it.');
      drawPhotoPreview();
    };
    const openPhotoModal = async ({ existing = false } = {}) => {
      photoModal?.classList.remove('hidden');
      photoModal?.classList.add('flex');
      setPhotoStatus(existing ? 'Loading current photo...' : 'Upload or drag a photo, then frame it.');
      if (existing && existingPhotoName) {
        const response = await fetch(`/file/${existingPhotoName}`);
        await loadPhotoBlob(await response.blob());
      }
    };
    const closePhotoModal = () => {
      photoModal?.classList.add('hidden');
      photoModal?.classList.remove('flex');
    };
    const exportPhotoFile = async () => {
      if (!photoImage) return null;
      const canvas = document.createElement('canvas');
      canvas.width = 1400;
      canvas.height = 1400;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const zoom = parseFloat(zoomInput?.value || '1');
      const baseScale = Math.min(canvas.width / photoImage.naturalWidth, canvas.height / photoImage.naturalHeight);
      const scale = baseScale * zoom;
      const width = photoImage.naturalWidth * scale;
      const height = photoImage.naturalHeight * scale;
      const x = (canvas.width - width) / 2 + (parseFloat(xInput?.value || '0') / 100) * canvas.width * 0.4;
      const y = (canvas.height - height) / 2 + (parseFloat(yInput?.value || '0') / 100) * canvas.height * 0.4;
      ctx.drawImage(photoImage, x, y, width, height);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png', 0.95));
      return new File([blob], 'garment-photo.png', { type: 'image/png' });
    };
    const waitForPhotoProcessing = () =>
      new Promise((resolve) => {
        uploadInput?.addEventListener('photo-processing-complete', resolve, { once: true });
      });
    const submitEditedPhoto = async () => {
      const file = await exportPhotoFile();
      if (!file || !uploadInput || !uploadForm) return;
      setPhotoStatus('Removing background... this can take a little while.');
      if (photoSave) photoSave.disabled = true;
      uploadInput.dataset.skipMaskEditor = 'true';
      const dt = new DataTransfer();
      dt.items.add(file);
      uploadInput.files = dt.files;
      const processing = waitForPhotoProcessing();
      uploadInput.dispatchEvent(new Event('change'));
      await processing;
      setPhotoStatus('Uploading photo...');
      closePhotoModal();
      uploadForm.requestSubmit();
    };

    document.getElementById('addPhotoButton')?.addEventListener('click', () => openPhotoModal());
    document.querySelector('[data-photo-edit-open="true"]')?.addEventListener('click', () => {
      if (!document.getElementById('editItemToggle')?.textContent?.includes('Editing')) return;
      openPhotoModal({ existing: true });
    });
    photoChoose?.addEventListener('click', () => photoFileInput?.click());
    photoDropZone?.addEventListener('click', (event) => {
      if (event.target === photoCanvas) return;
      photoFileInput?.click();
    });
    photoCanvas?.addEventListener('click', (event) => event.stopPropagation());
    photoCancel?.addEventListener('click', closePhotoModal);
    photoSave?.addEventListener('click', submitEditedPhoto);
    photoFileInput?.addEventListener('change', async () => {
      const file = photoFileInput.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    for (const input of [zoomInput, xInput, yInput]) {
      input?.addEventListener('input', drawPhotoPreview);
    }
    photoDropZone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      photoDropZone.classList.add('border-emerald-400');
    });
    photoDropZone?.addEventListener('dragleave', () => photoDropZone.classList.remove('border-emerald-400'));
    photoDropZone?.addEventListener('drop', async (event) => {
      event.preventDefault();
      photoDropZone.classList.remove('border-emerald-400');
      const file = event.dataTransfer?.files?.[0];
      if (file) await loadPhotoBlob(file);
    });
    photoCanvas?.addEventListener('pointerdown', (event) => {
      event.stopPropagation();
      photoDragging = true;
      lastPointer = { x: event.clientX, y: event.clientY };
      photoCanvas.setPointerCapture(event.pointerId);
    });
    photoCanvas?.addEventListener('pointermove', (event) => {
      if (!photoDragging || !lastPointer || !xInput || !yInput) return;
      const dx = event.clientX - lastPointer.x;
      const dy = event.clientY - lastPointer.y;
      xInput.value = String(Math.max(-100, Math.min(100, parseFloat(xInput.value) + dx / 3)));
      yInput.value = String(Math.max(-100, Math.min(100, parseFloat(yInput.value) + dy / 3)));
      lastPointer = { x: event.clientX, y: event.clientY };
      drawPhotoPreview();
    });
    photoCanvas?.addEventListener('pointerup', () => {
      photoDragging = false;
      lastPointer = null;
    });
    photoCanvas?.addEventListener('wheel', (event) => {
      if (!zoomInput) return;
      event.preventDefault();
      event.stopPropagation();
      const next = parseFloat(zoomInput.value) + (event.deltaY < 0 ? 0.08 : -0.08);
      zoomInput.value = String(Math.max(1, Math.min(3, next)));
      drawPhotoPreview();
    }, { passive: false });
    wireUpPhotoInput();
  </script>
</main>
